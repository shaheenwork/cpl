  "items": [
    {"id": "spin_kiss_once", "version": 1, "game": "SPIN", "kind": null, "text": "Kiss them once, slowly, and stop there.", "options": ["Their hand", "Their wrist", "Their cheek", "Their shoulder"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_flirting"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
