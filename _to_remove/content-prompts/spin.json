    {"id": "spin_cold_warm", "version": 1, "game": "SPIN", "kind": null, "text": "Bring something cool from the kitchen and use it there.", "options": ["Their throat", "Their wrists", "Their stomach", "Their spine"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_temperature", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_blindfolded_find", "version": 1, "game": "SPIN", "kind": null, "text": "Blindfold them, then make them guess where you are.", "options": ["Their neck", "Their hip", "Their thigh", "Their back"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_hands_behind", "version": 1, "game": "SPIN", "kind": null, "text": "Their hands stay behind their back while you take your time there.", "options": ["Their throat", "Their waist", "Their thighs", "Their stomach"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_leading", "power_yielding", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_until_they_beg", "version": 1, "game": "SPIN", "kind": null, "text": "Stay there, slowly, until they say your name.", "options": ["Their neck", "Their hips", "Their thighs", "Their lower back"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_who_decides", "version": 1, "game": "SPIN", "kind": null, "text": "It decides who runs the next five minutes. Whoever it is, the other one agrees now.", "options": ["You do", "They do", "You do, one veto each", "They do, one veto each"], "seconds": null, "category": "power", "tags": ["game", "choice", "lead"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["unpredictable", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_leading", "power_yielding"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_only_word", "version": 1, "game": "SPIN", "kind": null, "text": "It picks the only word either of you may say for the next two minutes. Make it work.", "options": ["Please", "Wait", "More", "Their name"], "seconds": null, "category": "teasing", "tags": ["game", "verbal", "whisper"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_how_long", "version": 1, "game": "SPIN", "kind": null, "text": "You already know what you want to do. It decides how long you have to keep doing it.", "options": ["One minute", "Three minutes", "Five, unhurried", "Until they ask you to stop"], "seconds": null, "category": "teasing", "tags": ["game", "anticipation", "slowBurn"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_what_with", "version": 1, "game": "SPIN", "kind": null, "text": "It decides what you are allowed to use this round. Nothing else, however tempting.", "options": ["Your hands", "Your mouth", "One fingertip", "Nothing but breath"], "seconds": null, "category": "sensory", "tags": ["game", "touch", "texture"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_the_rule", "version": 1, "game": "SPIN", "kind": null, "text": "It sets one rule and the rule holds until the round ends. Neither of you gets to argue.", "options": ["They may not move", "Neither of you speaks", "Eyes stay closed", "Nobody hurries"], "seconds": null, "category": "teasing", "tags": ["game", "dare", "choice"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["unpredictable", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_games", "power_negotiated"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_they_ask_for_it", "version": 1, "game": "SPIN", "kind": null, "text": "It picks what they have to ask you for. Nothing happens until they ask properly.", "options": ["A kiss on the neck", "Your hands in their hair", "Your full attention, two minutes", "Whatever they want, in plain words"], "seconds": null, "category": "communication", "tags": ["game", "verbal", "flirting"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_flirting", "teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_the_pace", "version": 1, "game": "SPIN", "kind": null, "text": "It picks the pace and you keep to it, especially when they would rather you did not.", "options": ["Half speed", "Slower than that", "Stop and start", "Their speed, not yours"], "seconds": null, "category": "teasing", "tags": ["game", "slowBurn", "anticipation"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_first_thing", "version": 1, "game": "SPIN", "kind": null, "text": "Whoever is holding the phone does whatever it lands on, right now, no run-up.", "options": ["A compliment, very specific", "A kiss, unhurried", "One thing of theirs comes off", "Nothing at all for a full minute"], "seconds": null, "category": "exploration", "tags": ["game", "surprise", "choice"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["unpredictable", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_games", "explore_surprise"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_who_says_it", "version": 1, "game": "SPIN", "kind": null, "text": "It decides which of you says what happens next, out loud, in plain words. No hinting.", "options": ["You say it", "They say it", "Both at once", "Neither: write it and hand it over"], "seconds": null, "category": "communication", "tags": ["game", "verbal", "desire"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_words", "comm_flirting"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_count_it_down", "version": 1, "game": "SPIN", "kind": null, "text": "It picks a number. Count down from it out loud, and nothing at all happens until one.", "options": ["Ten", "Twenty", "Thirty", "Sixty, slowly"], "seconds": null, "category": "teasing", "tags": ["game", "countdown", "anticipation"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_hands_stay", "version": 1, "game": "SPIN", "kind": null, "text": "It says where their hands stay for the rest of the round, and they keep them there.", "options": ["Behind their back", "Flat on the bed", "On you, not moving", "Wherever you put them"], "seconds": null, "category": "power", "tags": ["game", "instructions", "follow"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_yielding", "teasing_instructions"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_in_charge", "version": 1, "game": "SPIN", "kind": null, "text": "It decides which of you is in charge until the round ends. The card does not take questions.", "options": ["You are", "They are", "You are, they may ask once", "They are, you may ask once"], "seconds": null, "category": "power", "tags": ["game", "power", "switch"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_leading", "power_switching"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_one_layer_who", "version": 1, "game": "SPIN", "kind": null, "text": "It picks what comes off and who takes it off. Slowly enough that it counts as its own event.", "options": ["Yours, by them", "Theirs, by you", "Yours, by you", "Theirs, their choice"], "seconds": null, "category": "teasing", "tags": ["game", "teasing", "choice"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["mood_charged", "teasing_games"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_say_this_first", "version": 1, "game": "SPIN", "kind": null, "text": "It picks the sentence you have to say out loud before anything else happens tonight.", "options": ["What you want", "What you thought about today", "What you have never asked for", "What you would do with an uninterrupted hour"], "seconds": null, "category": "communication", "tags": ["game", "confession", "desire"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_confessions", "teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_who_waits", "version": 1, "game": "SPIN", "kind": null, "text": "It decides which of you waits, and how badly. Whoever asks first waits twice as long.", "options": ["You wait, five minutes", "They wait, five minutes", "Both of you, ten", "The one who spoke last"], "seconds": null, "category": "teasing", "tags": ["game", "anticipation", "slowBurn"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_the_instruction", "version": 1, "game": "SPIN", "kind": null, "text": "It picks the instruction. They follow it for the rest of the round without asking why.", "options": ["Do not move", "Do not make a sound", "Ask for it properly", "Keep your eyes on me"], "seconds": null, "category": "power", "tags": ["game", "instructions", "follow"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_instructions", "power_yielding"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_takes_it_away", "version": 1, "game": "SPIN", "kind": null, "text": "It takes one thing away from you for the rest of the round. Manage without it.", "options": ["Your hands", "Your mouth", "Your voice", "Your sight"], "seconds": null, "category": "sensory", "tags": ["game", "touch", "verbal"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["experimental", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_rate_it_aloud", "version": 1, "game": "SPIN", "kind": null, "text": "It picks what they have to score out loud, one to ten, while you are still going.", "options": ["This, right now", "The last thing you did", "How close they are to asking", "How well you are behaving"], "seconds": null, "category": "teasing", "tags": ["game", "verbal", "teasing"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_two_at_once", "version": 1, "game": "SPIN", "kind": null, "text": "It lands twice. Both of them happen at the same time, for as long as you can manage it.", "options": ["Hands", "Mouth", "Words in their ear", "A full minute of nothing"], "seconds": null, "category": "sensory", "tags": ["game", "touch", "whisper"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_the_price", "version": 1, "game": "SPIN", "kind": null, "text": "It sets the price. They pay it before anything else happens for them tonight.", "options": ["Ask out loud", "Wait ten minutes", "Say the thing they never say", "Whatever you name"], "seconds": null, "category": "power", "tags": ["game", "anticipation", "power"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_rest_of_evening", "version": 1, "game": "SPIN", "kind": null, "text": "It decides who is in charge of the rest of the evening. Agree the limits now, then hand it over.", "options": ["You", "They do", "You, then trade halfway", "Whoever loses the next round"], "seconds": null, "category": "power", "tags": ["game", "power", "switch"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "power_switching", "power_leading"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_rule_all_night", "version": 1, "game": "SPIN", "kind": null, "text": "It picks a rule that holds for the rest of the night, and the one it lands on cannot argue.", "options": ["No asking twice", "No stopping to explain", "No hands unless invited", "Nothing goes back on"], "seconds": null, "category": "power", "tags": ["game", "power", "instructions"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "teasing_instructions"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_how_far", "version": 1, "game": "SPIN", "kind": null, "text": "It picks how far this goes before you stop on purpose and leave it exactly there.", "options": ["Halfway", "Almost", "Further than last time", "All of it, no stopping"], "seconds": null, "category": "teasing", "tags": ["game", "anticipation", "slowBurn"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_blind_one", "version": 1, "game": "SPIN", "kind": null, "text": "Blindfold whoever it lands on. They stay that way until the round is over, and they are told nothing.", "options": ["You", "They do", "Both of you", "Whoever asks a question first"], "seconds": null, "category": "sensory", "tags": ["game", "blindfold", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_ask_anything", "version": 1, "game": "SPIN", "kind": null, "text": "It decides who gets to ask for anything at all. The other one already said yes, so mean it.", "options": ["You ask", "They ask", "You ask, in a whisper", "They ask, and you answer without words"], "seconds": null, "category": "power", "tags": ["game", "desire", "trust"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "spin_long_way_round", "version": 1, "game": "SPIN", "kind": null, "text": "It paces the rest of the night, and neither of you is allowed to hurry it along.", "options": ["An hour before anything", "Stop every five minutes", "Nothing until they ask twice", "Their pace entirely"], "seconds": null, "category": "teasing", "tags": ["game", "slowBurn", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "power_yielding"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"}
