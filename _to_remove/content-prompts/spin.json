    {"id": "spin_look_only", "version": 1, "game": "SPIN", "kind": null, "text": "Look at it for ten seconds without touching anything.", "options": ["Their mouth", "Their hands", "Their eyes", "Their throat"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_warm_breath", "version": 1, "game": "SPIN", "kind": null, "text": "Warm it with your hands, slowly, before you do anything else.", "options": ["Their hands", "Their arms", "Their feet", "Their face"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch", "sensory_temperature"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_ask_permission", "version": 1, "game": "SPIN", "kind": null, "text": "Ask before you touch it, then take your time.", "options": ["Their waist", "Their neck", "Their hair", "Their shoulders"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_trace_line", "version": 1, "game": "SPIN", "kind": null, "text": "Trace one slow line with a single fingertip.", "options": ["Their spine", "Their collarbone", "The inside of their arm", "Their palm"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch", "teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_breathe_close", "version": 1, "game": "SPIN", "kind": null, "text": "Get close enough that they feel you breathe, and do nothing else.", "options": ["Their ear", "Their neck", "Their shoulder", "Their cheek"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_kiss_slow_twice", "version": 1, "game": "SPIN", "kind": null, "text": "Kiss it twice. Take longer the second time.", "options": ["Their throat", "Their wrist", "Their fingertips", "Their shoulder"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_flirting", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_whisper_want", "version": 1, "game": "SPIN", "kind": null, "text": "Whisper what you want to do there. Don't do it yet.", "options": ["Their neck", "Their hip", "Their thigh", "Their lower back"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_words", "teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_undress_one", "version": 1, "game": "SPIN", "kind": null, "text": "Uncover it, and take your time about it.", "options": ["One shoulder", "Their back", "Their stomach", "One leg"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
    {"id": "spin_mark_lightly", "version": 1, "game": "SPIN", "kind": null, "text": "Leave a mark there that will still be there in the morning.", "options": ["Their neck", "Their shoulder", "Their hip", "Their inner arm"], "seconds": null, "category": "exploration", "tags": ["game", "surprise"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-26T00:00:00.000Z", "updatedAt": "2026-09-26T00:00:00.000Z"},
