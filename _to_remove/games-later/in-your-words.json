    {"id": "words_the_first_move", "version": 1, "game": "IN_YOUR_WORDS", "kind": null, "text": "What happens in the first sixty seconds after you both put the phone down.", "options": [], "seconds": null, "category": "teasing", "tags": ["game", "anticipation", "desire"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "words_unedited_one_line", "version": 1, "game": "IN_YOUR_WORDS", "kind": null, "text": "One line, whatever it is, and you are not allowed to soften it before you hand it over.", "options": [], "seconds": null, "category": "communication", "tags": ["game", "confession", "desire"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
