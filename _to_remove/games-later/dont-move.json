    {"id": "still_two_minutes_of_it", "version": 1, "game": "DONT_MOVE", "kind": null, "text": "Two minutes of being teased at the same steady pace. Flinching is moving.", "options": [], "seconds": 120, "category": "teasing", "tags": ["game", "teasing", "slowBurn"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "still_cool_on_skin", "version": 1, "game": "DONT_MOVE", "kind": null, "text": "Ice from the kitchen, used slowly, while the other one refuses to react.", "options": [], "seconds": 120, "category": "sensory", "tags": ["game", "temperature", "touch"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_temperature", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
