    {"id": "still_hands_behind", "version": 1, "game": "DONT_MOVE", "kind": null, "text": "Hands behind your back. They do as they like.", "options": [], "seconds": 90, "category": "exploration", "tags": ["game", "anticipation"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_yielding", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "still_eyes_shut", "version": 1, "game": "DONT_MOVE", "kind": null, "text": "Eyes shut, and they try to make you move.", "options": [], "seconds": 90, "category": "exploration", "tags": ["game", "anticipation"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "power_yielding"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
