    {"id": "still_they_choose_the_stake", "version": 1, "game": "DONT_MOVE", "kind": null, "text": "Whoever loses agreed to the stake before it started. Neither of you gets to renegotiate now.", "options": [], "seconds": 150, "category": "power", "tags": ["game", "power", "dare"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
