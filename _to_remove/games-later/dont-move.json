    {"id": "still_no_asking", "version": 1, "game": "DONT_MOVE", "kind": null, "text": "You may not ask for anything, or move, until the clock stops.", "options": [], "seconds": 150, "category": "exploration", "tags": ["game", "anticipation"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "power_negotiated"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "still_whole_three", "version": 1, "game": "DONT_MOVE", "kind": null, "text": "Three minutes. They do whatever they like. You do not move.", "options": [], "seconds": 180, "category": "exploration", "tags": ["game", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_yielding", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "still_no_matter", "version": 1, "game": "DONT_MOVE", "kind": null, "text": "Whatever happens, you stay where you are.", "options": [], "seconds": 150, "category": "exploration", "tags": ["game", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_yielding", "power_negotiated", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
