    {"id": "still_two_minutes", "version": 1, "game": "DONT_MOVE", "kind": null, "text": "Two minutes, no movement, whatever they do.", "options": [], "seconds": 120, "category": "exploration", "tags": ["game", "anticipation"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_yielding", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
