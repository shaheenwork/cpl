    {"id": "still_three_whole_minutes", "version": 1, "game": "DONT_MOVE", "kind": null, "text": "Three minutes. One of you does whatever they like. The other may not move a muscle.", "options": [], "seconds": 180, "category": "teasing", "tags": ["game", "dare", "slowBurn"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_games", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
