    {"id": "fant_they_ask_for_it", "version": 1, "game": "BUILD_THE_FANTASY", "kind": null, "text": "Open with one of them asking out loud for exactly what they want, in the plainest words they have.", "options": [], "seconds": null, "category": "communication", "tags": ["game", "fantasy", "desire"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_fantasies", "teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
