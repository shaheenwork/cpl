    {"id": "fant_watched_from_the_door", "version": 1, "game": "BUILD_THE_FANTASY", "kind": null, "text": "Open with one of them in the doorway, doing nothing, for longer than is comfortable.", "options": [], "seconds": null, "category": "teasing", "tags": ["game", "storytelling", "teasing"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_fantasies", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "fant_trade_places", "version": 1, "game": "BUILD_THE_FANTASY", "kind": null, "text": "Open with whoever usually decides having handed it over, and both of them finding out how that goes.", "options": [], "seconds": null, "category": "power", "tags": ["game", "switch", "storytelling"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_fantasies", "power_switching"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "fant_the_uncut_version", "version": 1, "game": "BUILD_THE_FANTASY", "kind": null, "text": "Open where you would normally stop telling it, and go on from there.", "options": [], "seconds": null, "category": "communication", "tags": ["game", "fantasy", "storytelling"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_fantasies", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
