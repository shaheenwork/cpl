    { "pattern": "blindfold\\w*", "themes": ["sensory_blindfold"] },
    { "pattern": "ice(?: cubes?)?|temperature|warm and cool", "themes": ["sensory_temperature"] },
    { "pattern": "massag\\w*", "themes": ["sensory_touch"] },
