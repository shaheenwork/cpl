    { "pattern": "safe ?word", "themes": ["power_negotiated", "roleplay_power"] },
    { "pattern": "voice (?:notes?|memos?|messages?)", "themes": ["comm_voice"] },
    {
      "pattern": "fantas(?:y|ies|ise|ize)\\w*",
      "themes": ["comm_fantasies", "roleplay_characters", "roleplay_strangers", "roleplay_power"]
