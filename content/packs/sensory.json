{
  "pack": "SENSORY",
  "items": [
    {"id": "sensory_set_the_room", "version": 1, "title": "Set the Room", "subtitle": "Light, sound, scent.", "body": "Take five minutes to change the room for the two of you: the lighting, the music, one scent. Then sit back and notice what changed.", "pack": "SENSORY", "category": "sensory", "tags": ["lighting", "music", "scent"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 10, "moods": ["romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_lighting", "sensory_music", "sensory_scent"], "excludedByBoundaries": ["sensory_atmosphere"], "chapterKinds": ["WARM_UP", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_our_song_hunt", "version": 1, "title": "Our Song", "subtitle": "Find it together.", "body": "Play each other five songs each until you find one that should be yours. It must make you both look at each other at the same moment.", "pack": "SENSORY", "category": "sensory", "tags": ["music", "memories", "choice"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "SENSORY", "durationMin": 20, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_music"], "excludedByBoundaries": ["sensory_atmosphere"], "chapterKinds": ["WARM_UP", "YOUR_CHOICE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_candlelight_only", "version": 1, "title": "Candlelight Only", "subtitle": "Everything else off.", "body": "Switch off every light and every screen. Spend the next half hour by candlelight only, talking about anything.", "pack": "SENSORY", "category": "sensory", "tags": ["lighting", "slowBurn"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 30, "moods": ["romantic", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_lighting", "mood_slow"], "excludedByBoundaries": ["sensory_atmosphere", "mood_gentle"], "chapterKinds": ["WARM_UP", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_scent_memory", "version": 1, "title": "Scent Memory", "subtitle": "Which scent is them?", "body": "Tell them which scent always reminds you of them, and the moment it first did. If you can find it, let them smell it now.", "pack": "SENSORY", "category": "sensory", "tags": ["scent", "memories"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_scent"], "excludedByBoundaries": ["sensory_atmosphere"], "chapterKinds": ["WARM_UP", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_taste_test", "version": 1, "title": "Taste Test", "subtitle": "Eyes closed. Guess it.", "body": "Take turns feeding each other small bites with your eyes closed. Guess each one. Every right answer earns a kiss.", "pack": "SENSORY", "category": "sensory", "tags": ["taste", "game", "kissing"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 10, "moods": ["romantic", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_playful", "explore_shared_curiosity"], "excludedByBoundaries": ["mood_gentle", "explore_shared_curiosity"], "chapterKinds": ["WARM_UP", "CHALLENGE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_synced_song", "version": 1, "title": "Same Song, Same Time", "subtitle": "Wherever you are.", "body": "Agree on a song and press play at exactly the same moment, wherever you both are. Message each other one word when it ends.", "pack": "SENSORY", "category": "sensory", "tags": ["music", "distance", "ritual"], "intensity": 1, "modes": ["APART"], "interactionType": "SENSORY", "durationMin": 5, "moods": ["romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_music"], "excludedByBoundaries": ["sensory_atmosphere"], "chapterKinds": ["WARM_UP", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_scented_letter", "version": 1, "title": "The Scented Letter", "subtitle": "Something they'll recognise.", "body": "Send them a handwritten note with a trace of your scent on it. Ask them what they thought of first when they opened it.", "pack": "SENSORY", "category": "sensory", "tags": ["scent", "letter", "surprise"], "intensity": 1, "modes": ["APART"], "interactionType": "SURPRISE", "durationMin": 10, "moods": ["romantic", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_scent", "explore_being_surprised"], "excludedByBoundaries": ["sensory_atmosphere", "explore_surprise"], "chapterKinds": ["WILDCARD", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_hands_warm", "version": 1, "title": "Warm Hands", "subtitle": "Hold them, that's all.", "body": "Hold their hands in yours for two full minutes without talking. Notice every small thing: temperature, pressure, pulse.", "pack": "SENSORY", "category": "sensory", "tags": ["touch", "slowBurn"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 3, "moods": ["romantic", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_slow", "sensory_temperature"], "excludedByBoundaries": ["mood_gentle", "sensory_temperature"], "chapterKinds": ["WARM_UP", "TEASE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_sound_map", "version": 1, "title": "What I Can Hear", "subtitle": "Describe it to them.", "body": "Close your eyes wherever you are and describe to them every sound you can hear, then how it would change if they were next to you.", "pack": "SENSORY", "category": "sensory", "tags": ["distance", "voice", "storytelling"], "intensity": 1, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 5, "moods": ["romantic", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_music", "comm_storytelling"], "excludedByBoundaries": ["sensory_atmosphere", "comm_fantasies"], "chapterKinds": ["WARM_UP", "CURIOSITY"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_slow_down_hour", "version": 1, "title": "The Slow Half Hour", "subtitle": "Everything at half speed.", "body": "For half an hour, do everything together at half speed: eating, talking, walking, touching. Notice what you usually rush past.", "pack": "SENSORY", "category": "sensory", "tags": ["slowBurn", "ritual"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 30, "moods": ["romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_slow"], "excludedByBoundaries": ["mood_gentle"], "chapterKinds": ["WARM_UP", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_shoulder_massage", "version": 1, "title": "Five-Minute Massage", "subtitle": "Shoulders only.", "body": "Give them a slow five-minute massage, shoulders and neck only. Ask twice what feels good and do more of it.", "pack": "SENSORY", "category": "sensory", "tags": ["massage", "touch"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 5, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_massage"], "excludedByBoundaries": ["sensory_touch"], "chapterKinds": ["WARM_UP", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_fabric_game", "version": 1, "title": "Guess the Texture", "subtitle": "Eyes closed.", "body": "Collect four things with different textures: silk, wool, a feather, something cool. With their eyes closed, trace each along their arm. They guess.", "pack": "SENSORY", "category": "sensory", "tags": ["texture", "touch", "game"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 8, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_texture"], "excludedByBoundaries": ["sensory_touch"], "chapterKinds": ["TEASE", "CHALLENGE"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_heartbeat", "version": 1, "title": "Heartbeat", "subtitle": "Listen closely.", "body": "Rest your head on their chest and listen to their heartbeat until it changes. Tell them what you think changed it.", "pack": "SENSORY", "category": "sensory", "tags": ["touch", "anticipation"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 3, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_slow", "mood_romantic"], "excludedByBoundaries": ["mood_gentle", "sensory_touch"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_perfume_trail", "version": 1, "title": "The Trail", "subtitle": "Follow your nose.", "body": "Put a little of your scent in three places around your home. Give them one clue. They follow the trail to find you.", "pack": "SENSORY", "category": "sensory", "tags": ["scent", "game", "surprise"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 10, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_scent", "teasing_playful_challenges"], "excludedByBoundaries": ["sensory_atmosphere", "teasing_games"], "chapterKinds": ["WILDCARD", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_lighting_mood", "version": 1, "title": "Change the Light", "subtitle": "Every colour, a mood.", "body": "Dim the lights to three different levels over the evening. At each one, tell them what that light makes you want to do.", "pack": "SENSORY", "category": "sensory", "tags": ["lighting", "desire"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 15, "moods": ["naughty", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_lighting"], "excludedByBoundaries": ["sensory_atmosphere"], "chapterKinds": ["TEASE", "CURIOSITY"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_playlist_for_them", "version": 1, "title": "A Playlist for Tonight", "subtitle": "Made for their ears.", "body": "Make them a playlist for tonight, whether you are together or apart, that starts sweet and slowly turns into something else.", "pack": "SENSORY", "category": "sensory", "tags": ["music", "anticipation", "gift"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "SENSORY", "durationMin": 20, "moods": ["naughty", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_music", "teasing_anticipation"], "excludedByBoundaries": ["sensory_atmosphere", "teasing_anticipation"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_hand_massage", "version": 1, "title": "Hands First", "subtitle": "Every finger.", "body": "Give each of their hands a slow massage, every finger, every knuckle. Say nothing. Let them notice how long you take.", "pack": "SENSORY", "category": "sensory", "tags": ["massage", "touch", "slowBurn"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 8, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_massage", "mood_slow"], "excludedByBoundaries": ["sensory_touch", "mood_gentle"], "chapterKinds": ["TEASE", "WARM_UP"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_voice", "version": 1, "title": "Your Voice, Low", "subtitle": "Headphones on.", "body": "Record a voice message describing the room you wish you were in with them right now: the light, the sounds, the warmth. Ask them to listen with headphones.", "pack": "SENSORY", "category": "sensory", "tags": ["voice", "lighting", "distance"], "intensity": 2, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 5, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_voice", "sensory_lighting"], "excludedByBoundaries": ["comm_voice", "sensory_atmosphere"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_breathe_together", "version": 1, "title": "Breathe Together", "subtitle": "In, and out.", "body": "Lie close and match your breathing to theirs for three minutes. Then let yours slow down and see if they follow.", "pack": "SENSORY", "category": "sensory", "tags": ["touch", "slowBurn", "trust"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 5, "moods": ["romantic", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_slow", "explore_trust"], "excludedByBoundaries": ["mood_gentle", "explore_trust"], "chapterKinds": ["WARM_UP", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_blindfold_taste", "version": 1, "title": "Blindfolded Tasting", "subtitle": "Five bites.", "body": "Blindfold them and feed them five small tastes, sweet, sour, something surprising. Make each one arrive a little more slowly.", "pack": "SENSORY", "category": "sensory", "tags": ["blindfold", "taste", "anticipation"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 10, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_blindfold"], "excludedByBoundaries": ["sensory_blindfold"], "chapterKinds": ["TEASE", "WILDCARD"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_massage_long", "version": 1, "title": "The Long Massage", "subtitle": "Twenty minutes. No rushing.", "body": "Give them a twenty-minute massage with warm oil and low music. No rushing, and no talking except to ask what feels good.", "pack": "SENSORY", "category": "sensory", "tags": ["massage", "touch", "music"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 20, "moods": ["naughty", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_massage", "sensory_music"], "excludedByBoundaries": ["sensory_touch", "sensory_atmosphere"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_feather_touch", "version": 1, "title": "Lightest Touch", "subtitle": "Barely there.", "body": "With the lightest touch you can manage, trace slow lines along their arms, neck and back. Stop whenever they start to lean in.", "pack": "SENSORY", "category": "sensory", "tags": ["touch", "texture", "anticipation"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 8, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_texture", "teasing_anticipation"], "excludedByBoundaries": ["sensory_touch", "teasing_anticipation"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_warm_and_cool_hands", "version": 1, "title": "Warm, Then Cool", "subtitle": "The contrast.", "body": "Warm your hands on a cup of tea, then cool them on a glass of water. Let them feel the difference against their skin, back and forth.", "pack": "SENSORY", "category": "sensory", "tags": ["temperature", "touch", "anticipation"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 5, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_temperature"], "excludedByBoundaries": ["sensory_temperature"], "chapterKinds": ["TEASE", "WILDCARD"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_scent_on_skin", "version": 1, "title": "Where Is It?", "subtitle": "Find the scent.", "body": "Put the smallest trace of a scent somewhere on your skin. They have to find exactly where, using only their nose.", "pack": "SENSORY", "category": "sensory", "tags": ["scent", "game", "anticipation"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 5, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_scent", "mood_naughty"], "excludedByBoundaries": ["sensory_atmosphere", "mood_charged"], "chapterKinds": ["TEASE", "CHALLENGE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_describe_your_touch", "version": 1, "title": "Describe Your Touch", "subtitle": "By message.", "body": "Message them the way you would touch them if you were together now, slowly, one message per minute. Stop at five.", "pack": "SENSORY", "category": "sensory", "tags": ["touch", "message", "desire"], "intensity": 3, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 5, "moods": ["naughty", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_naughty", "teasing_verbal"], "excludedByBoundaries": ["mood_charged", "teasing_words"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_the_playlist_game", "version": 1, "title": "Every Track, a Kiss", "subtitle": "Ten songs.", "body": "Play ten songs. On every new track, the person whose turn it is chooses where the next kiss goes.", "pack": "SENSORY", "category": "sensory", "tags": ["music", "kissing", "game"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 30, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_music", "teasing_playful_challenges"], "excludedByBoundaries": ["sensory_atmosphere", "teasing_games"], "chapterKinds": ["TEASE", "YOUR_CHOICE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_eyes_closed_kiss", "version": 1, "title": "Eyes Closed", "subtitle": "All the other senses.", "body": "Both of you close your eyes for five minutes. Kiss, touch and listen without looking once. Talk about what felt different.", "pack": "SENSORY", "category": "sensory", "tags": ["kissing", "touch", "trust"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 8, "moods": ["naughty", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_naughty", "explore_trust"], "excludedByBoundaries": ["mood_charged", "explore_trust", "sensory_touch"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_video_call", "version": 1, "title": "Show Me Your Room", "subtitle": "Candlelit call.", "body": "On a video call, both of you light a candle and turn every other light off. Talk for twenty minutes by candlelight, as close to the screen as you like.", "pack": "SENSORY", "category": "sensory", "tags": ["lighting", "distance", "voice"], "intensity": 3, "modes": ["APART"], "interactionType": "SENSORY", "durationMin": 20, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_lighting", "mood_naughty"], "excludedByBoundaries": ["sensory_atmosphere", "mood_charged"], "chapterKinds": ["WARM_UP", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_blindfold_trust", "version": 1, "title": "Blindfold and Trust", "subtitle": "They choose what comes next.", "body": "Blindfold one of you. For ten minutes the other decides every sensation: a touch, a whisper, a pause, a kiss. Nothing unannounced beyond what you agreed.", "pack": "SENSORY", "category": "sensory", "tags": ["blindfold", "trust", "touch"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 10, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_blindfold", "explore_trust"], "excludedByBoundaries": ["sensory_blindfold", "explore_trust"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_ice_and_warm", "version": 1, "title": "Ice and Warmth", "subtitle": "Slowly, with care.", "body": "With their agreement, trace a piece of ice slowly along their arm or back, then follow it with your warm hand. Stop at their first 'enough'.", "pack": "SENSORY", "category": "sensory", "tags": ["temperature", "touch", "anticipation"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 8, "moods": ["bold", "naughty"], "requiredMutualPreferences": ["sensory_temperature"], "boostedByPreferences": ["sensory_temperature"], "excludedByBoundaries": ["sensory_temperature"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_full_massage", "version": 1, "title": "The Full Massage", "subtitle": "Everything slowed right down.", "body": "Give them a slow, unhurried full-body massage with warm oil, low light and quiet music. Ask what they want more of, and give it.", "pack": "SENSORY", "category": "sensory", "tags": ["massage", "touch", "lighting"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 30, "moods": ["bold", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_massage", "sensory_lighting"], "excludedByBoundaries": ["sensory_touch", "sensory_atmosphere"], "chapterKinds": ["FINALE", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_senses_one_by_one", "version": 1, "title": "One Sense at a Time", "subtitle": "Sight, sound, touch.", "body": "Spend five minutes on each sense in turn: only looking, only whispering, only touching. Save the last sense for last.", "pack": "SENSORY", "category": "sensory", "tags": ["touch", "whisper", "eyeContact"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 20, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_intense", "sensory_texture"], "excludedByBoundaries": ["mood_charged", "sensory_touch"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_texture_trail", "version": 1, "title": "The Texture Trail", "subtitle": "Silk, then something else.", "body": "Blindfolded, they feel a trail of textures along their skin: silk, a feather, your fingertips, your breath. They may say 'again' to any of them.", "pack": "SENSORY", "category": "sensory", "tags": ["texture", "blindfold", "touch"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 10, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_texture", "sensory_blindfold"], "excludedByBoundaries": ["sensory_touch", "sensory_blindfold"], "chapterKinds": ["TEASE", "WILDCARD"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_voice_bold", "version": 1, "title": "Close Your Eyes and Listen", "subtitle": "Recorded for later.", "body": "Record a voice message describing, in slow detail, a sensory evening together: the light, the warmth, where your hands go first.", "pack": "SENSORY", "category": "sensory", "tags": ["voice", "desire", "anticipation"], "intensity": 4, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 5, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_voice", "mood_intense"], "excludedByBoundaries": ["comm_voice", "mood_charged"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_slow_undress_words", "version": 1, "title": "Slower", "subtitle": "Everything takes twice as long.", "body": "Whatever you do next, take twice as long as feels natural. Every time they try to hurry, whisper 'slower'.", "pack": "SENSORY", "category": "sensory", "tags": ["slowBurn", "whisper", "anticipation"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 10, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_slow", "teasing_anticipation"], "excludedByBoundaries": ["mood_gentle", "teasing_anticipation"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_scent_blind", "version": 1, "title": "Blind Scent", "subtitle": "Which one is you?", "body": "Blindfolded, they smell three things, one of them your skin. They choose. Whatever they choose, they may kiss.", "pack": "SENSORY", "category": "sensory", "tags": ["scent", "blindfold", "game"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 5, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_scent", "sensory_blindfold"], "excludedByBoundaries": ["sensory_atmosphere", "sensory_blindfold"], "chapterKinds": ["WILDCARD", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_sync_apart_senses", "version": 1, "title": "Same Room, Far Apart", "subtitle": "Build it together.", "body": "Apart, build the same scene at the same time: dim light, the same song, a candle each. Then describe to each other, by voice, what you would do next.", "pack": "SENSORY", "category": "sensory", "tags": ["lighting", "music", "distance"], "intensity": 4, "modes": ["APART"], "interactionType": "SENSORY", "durationMin": 20, "moods": ["bold", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_lighting", "sensory_music"], "excludedByBoundaries": ["sensory_atmosphere"], "chapterKinds": ["FINALE", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_blindfold_evening", "version": 1, "title": "The Blindfolded Evening", "subtitle": "Only what you agreed.", "body": "One of you stays blindfolded for the whole of the next half hour. Everything they experience is a choice the other made, inside your agreed limits.", "pack": "SENSORY", "category": "sensory", "tags": ["blindfold", "trust", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 30, "moods": ["bold", "mysterious"], "requiredMutualPreferences": ["sensory_blindfold"], "boostedByPreferences": ["sensory_blindfold", "explore_trust"], "excludedByBoundaries": ["sensory_blindfold", "explore_trust"], "chapterKinds": ["FINALE", "CONTROL"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_temperature_play_slow", "version": 1, "title": "Hot and Cold", "subtitle": "Agreed first. Slow always.", "body": "Agree where and how, then alternate ice and a warm cup against their skin, slowly, pausing for their word each time.", "pack": "SENSORY", "category": "sensory", "tags": ["temperature", "touch", "checkIn"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 10, "moods": ["bold", "naughty"], "requiredMutualPreferences": ["sensory_temperature"], "boostedByPreferences": ["sensory_temperature", "explore_trust"], "excludedByBoundaries": ["sensory_temperature", "explore_trust"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_every_sense", "version": 1, "title": "Every Sense", "subtitle": "All five, one night.", "body": "Plan one night that touches every sense: a scent on the pillow, a song you chose, a taste, a texture, and the light just right. Then enjoy it.", "pack": "SENSORY", "category": "sensory", "tags": ["scent", "music", "texture"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 30, "moods": ["bold", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_scent", "sensory_texture"], "excludedByBoundaries": ["sensory_atmosphere", "sensory_touch"], "chapterKinds": ["FINALE", "YOUR_CHOICE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_the_slowest_kiss", "version": 1, "title": "The Slowest Kiss", "subtitle": "Five minutes long.", "body": "Make one kiss last five full minutes, as slowly as either of you can stand. Nothing else happens until it ends.", "pack": "SENSORY", "category": "sensory", "tags": ["kissing", "slowBurn", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 5, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_intense", "teasing_anticipation"], "excludedByBoundaries": ["mood_charged", "teasing_anticipation"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_director", "version": 1, "title": "They Direct the Senses", "subtitle": "Blindfold on, voice only.", "body": "Blindfolded, one of you gives the other whispered instructions for exactly how to touch them, slowly, within your limits.", "pack": "SENSORY", "category": "sensory", "tags": ["blindfold", "instructions", "touch"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 15, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_blindfold", "power_take_the_lead"], "excludedByBoundaries": ["sensory_blindfold", "power_leading", "power_yielding"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_silk_and_patience", "version": 1, "title": "Silk and Patience", "subtitle": "No hurrying allowed.", "body": "Trace silk over their skin for ten slow minutes, anywhere they have agreed, and nowhere they have not. They may not touch you back.", "pack": "SENSORY", "category": "sensory", "tags": ["texture", "touch", "slowBurn"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 10, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_texture", "teasing_anticipation"], "excludedByBoundaries": ["sensory_touch", "teasing_anticipation"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_voice_in_the_dark", "version": 1, "title": "Voice in the Dark", "subtitle": "A call with the lights out.", "body": "Call each other with every light off. Describe, slowly, exactly what you would do if the other were within reach.", "pack": "SENSORY", "category": "sensory", "tags": ["voice", "lighting", "desire"], "intensity": 5, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 20, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_voice", "mood_intense"], "excludedByBoundaries": ["comm_voice", "mood_charged"], "chapterKinds": ["FINALE", "TEASE"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_overload", "version": 1, "title": "Everything at Once", "subtitle": "Then nothing at all.", "body": "Music loud, lights low, a scent in the air, hands everywhere agreed. Then, at a signal, stop everything and stay perfectly still together.", "pack": "SENSORY", "category": "sensory", "tags": ["music", "lighting", "touch"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 10, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_music", "mood_intense"], "excludedByBoundaries": ["sensory_atmosphere", "mood_charged", "sensory_touch"], "chapterKinds": ["FINALE", "WILDCARD"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "sensory_massage_extended", "version": 1, "title": "Nowhere to Be", "subtitle": "An hour. Just this.", "body": "Give them a whole hour of massage with nowhere else to be. They decide at the end how the hour should finish.", "pack": "SENSORY", "category": "sensory", "tags": ["massage", "touch", "choice"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "SENSORY", "durationMin": 30, "moods": ["bold", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_massage", "power_partner_decides"], "excludedByBoundaries": ["sensory_touch", "power_yielding"], "chapterKinds": ["FINALE", "YOUR_CHOICE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"}
  ]
}
