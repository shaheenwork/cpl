    {"id": "fantasy_role_fantasy_pitch", "version": 1, "title": "Pitch a Character", "subtitle": "Who would you be?", "body": "Pitch a character you would love to play for them for one evening: name, backstory, one line of dialogue. They decide if you're cast.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "characters", "storytelling"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "ROLEPLAY", "durationMin": 6, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "roleplay_characters"], "excludedByBoundaries": ["comm_fantasies", "roleplay_characters"], "chapterKinds": ["ROLEPLAY", "YOUR_CHOICE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_whisper", "version": 1, "title": "Whisper It Instead", "subtitle": "Too much to say out loud.", "body": "Whisper a fantasy you would not say at full volume. They respond only with a look: yes, maybe, or not for me.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "whisper", "checkIn"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "teasing_verbal"], "excludedByBoundaries": ["comm_fantasies", "teasing_words"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_in_detail", "version": 1, "title": "In Detail", "subtitle": "The one you keep coming back to.", "body": "Describe the fantasy about them you keep coming back to, in as much detail as you both want. Either of you can pause it any time.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "desire", "confession"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 8, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "mood_intense"], "excludedByBoundaries": ["comm_fantasies", "mood_charged"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_draft", "version": 1, "title": "Draft It Together", "subtitle": "Write the scene.", "body": "Write a short fantasy scene about the two of you together, one paragraph each. Read the finished version aloud in the dark.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "storytelling", "lighting"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONVERSATION", "durationMin": 15, "moods": ["bold", "roleplay"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "comm_storytelling"], "excludedByBoundaries": ["comm_fantasies"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_the_fantasy_list", "version": 1, "title": "The Fantasy List", "subtitle": "Ranked. Real.", "body": "Each write three fantasies on paper, ranked. Compare lists. Anything on both lists goes straight to the top of the shared one.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "choice", "checkIn"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CHOICE", "durationMin": 10, "moods": ["bold", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "explore_shared_curiosity"], "excludedByBoundaries": ["comm_fantasies", "explore_shared_curiosity"], "chapterKinds": ["YOUR_CHOICE", "CONFESSION"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_power_edition", "version": 1, "title": "Who Leads in It", "subtitle": "In your fantasy, who's in charge?", "body": "Describe a fantasy where one of you is in charge for the night. Who is it, and what is the first thing they decide?", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "power", "lead"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 6, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "power_take_the_lead"], "excludedByBoundaries": ["comm_fantasies", "power_leading"], "chapterKinds": ["CONTROL", "CURIOSITY"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_voice_bold", "version": 1, "title": "Tell It Slowly", "subtitle": "Recorded, unhurried.", "body": "Record yourself telling them a fantasy about the two of you, slowly, for no more than three minutes. They listen when they are alone.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["voice", "fantasy", "desire"], "intensity": 4, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 5, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "comm_voice"], "excludedByBoundaries": ["comm_fantasies", "comm_voice"], "chapterKinds": ["FINALE", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_negotiate", "version": 1, "title": "Make It Real", "subtitle": "One detail at a time.", "body": "Pick one fantasy you both like. Agree, detail by detail, which parts you would actually try and which stay in your heads.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "checkIn", "planning"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["bold", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "explore_something_new"], "excludedByBoundaries": ["comm_fantasies", "explore_novelty"], "chapterKinds": ["YOUR_CHOICE", "CONFESSION"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_on_demand", "version": 1, "title": "Your Turn to Ask", "subtitle": "Ask for a fantasy.", "body": "Ask them for a fantasy on a theme of your choosing, like 'somewhere dark' or 'a long weekend away'. They tell it their way.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "choice", "storytelling"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CHOICE", "durationMin": 6, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "teasing_surprise_choices"], "excludedByBoundaries": ["comm_fantasies", "teasing_games"], "chapterKinds": ["YOUR_CHOICE", "WILDCARD"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_morning_after", "version": 1, "title": "The Morning After", "subtitle": "Of the fantasy.", "body": "Describe the morning after your wildest fantasy about the two of you: where you wake up, what you say, what you still remember.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "storytelling", "morning"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 5, "moods": ["bold", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "mood_intense"], "excludedByBoundaries": ["comm_fantasies", "mood_charged"], "chapterKinds": ["CURIOSITY", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_message_series", "version": 1, "title": "In Instalments", "subtitle": "One part each day.", "body": "Send them a fantasy in three instalments, one a day, each ending at the best possible moment.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "anticipation", "message"], "intensity": 4, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 5, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "teasing_delayed_reveal"], "excludedByBoundaries": ["comm_fantasies", "teasing_anticipation"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_details_they_choose", "version": 1, "title": "They Choose the Details", "subtitle": "You tell the story.", "body": "Start telling a fantasy. Every time you pause, they choose the next detail: where, what you are wearing, who speaks first.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "choice", "power"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 8, "moods": ["bold", "roleplay"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "power_partner_decides"], "excludedByBoundaries": ["comm_fantasies", "power_yielding"], "chapterKinds": ["CONTROL", "ROLEPLAY"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_the_unsaid_fantasy", "version": 1, "title": "The Unsaid One", "subtitle": "The one you've never told anyone.", "body": "Tell them a fantasy you have never told anyone. They answer honestly: yes, maybe, not for me. Every answer is a good answer.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "confession", "checkIn"], "intensity": 5, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 8, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "comm_secrets"], "excludedByBoundaries": ["comm_fantasies", "comm_confessions"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_tonight", "version": 1, "title": "Tonight, If We Could", "subtitle": "Within your limits.", "body": "Describe, in full, the fantasy you would choose for tonight if anything within your agreed limits were possible. Then pick one piece of it to make real.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "desire", "choice"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "mood_intense"], "excludedByBoundaries": ["comm_fantasies", "mood_charged"], "chapterKinds": ["FINALE", "YOUR_CHOICE"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_trade", "version": 1, "title": "Fantasy for a Fantasy", "subtitle": "Only if both say yes.", "body": "Trade one fantasy each, told in full. If both of you say yes to both, you have your next two nights planned.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "checkIn", "planning"], "intensity": 5, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 10, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "explore_shared_curiosity"], "excludedByBoundaries": ["comm_fantasies", "explore_shared_curiosity"], "chapterKinds": ["CONFESSION", "YOUR_CHOICE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_scripted", "version": 1, "title": "Script It", "subtitle": "Every line agreed.", "body": "Write the script for a fantasy scene, with every line agreed by both of you before anything happens. Then decide when to perform it.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "roleplay", "planning"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 15, "moods": ["bold", "roleplay"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "roleplay_fantasy"], "excludedByBoundaries": ["comm_fantasies", "roleplay_characters"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_no_holding_back", "version": 1, "title": "No Holding Back", "subtitle": "Say all of it.", "body": "Tell them your boldest fantasy about the two of you without holding back a single detail you would want them to know. They may stop you with one word.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "desire", "checkIn"], "intensity": 5, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 8, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "mood_intense"], "excludedByBoundaries": ["comm_fantasies", "mood_charged"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_late_voice", "version": 1, "title": "Midnight Story", "subtitle": "Your voice, their ears only.", "body": "Record a story for them to listen to at midnight: a fantasy about the two of you, told the way you would tell it lying next to them.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["voice", "fantasy", "bedtime"], "intensity": 5, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 8, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "comm_voice"], "excludedByBoundaries": ["comm_fantasies", "comm_voice"], "chapterKinds": ["FINALE", "TEASE"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_director", "version": 1, "title": "You Direct It", "subtitle": "They play along.", "body": "Describe a fantasy scene and direct them through it, word by word, only as far as you both agreed beforehand.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "power", "instructions"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 15, "moods": ["bold", "roleplay"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "power_direct_the_evening"], "excludedByBoundaries": ["comm_fantasies", "power_leading", "power_negotiated"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_bucket_list", "version": 1, "title": "The Wild List", "subtitle": "Kept somewhere safe.", "body": "Make a list together of five bold fantasies you both want to try someday. Keep it somewhere only the two of you will ever find.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "future", "planning"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONVERSATION", "durationMin": 15, "moods": ["bold", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "explore_something_new"], "excludedByBoundaries": ["comm_fantasies", "explore_novelty"], "chapterKinds": ["YOUR_CHOICE", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_answer_honestly", "version": 1, "title": "Honest Answers", "subtitle": "Five questions.", "body": "Ask each other five bold questions about your fantasies. Answer each one honestly or with a single kiss. Nobody explains a kiss.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "kissing", "game"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CHALLENGE", "durationMin": 10, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "teasing_playful_challenges"], "excludedByBoundaries": ["comm_fantasies", "teasing_games"], "chapterKinds": ["CHALLENGE", "CONFESSION"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_the_details", "version": 1, "title": "The Details Matter", "subtitle": "Sound, light, time.", "body": "Describe a fantasy only through the details around it: the sound, the light, the time on the clock. They fill in the rest.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "lighting", "anticipation"], "intensity": 5, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 6, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "sensory_lighting"], "excludedByBoundaries": ["comm_fantasies", "sensory_atmosphere"], "chapterKinds": ["CURIOSITY", "TEASE"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_by_message_wild", "version": 1, "title": "Written, Not Said", "subtitle": "Easier to write.", "body": "Message them the fantasy that is easier to write than to say. They reply with the one part they would most like to hear out loud.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "message", "desire"], "intensity": 5, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 8, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "mood_intense"], "excludedByBoundaries": ["comm_fantasies", "mood_charged"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "fantasy_ending", "version": 1, "title": "The Ending", "subtitle": "Choose it together.", "body": "Tell a fantasy up to its best moment and stop. Decide together how it ends, and whether that ending happens tonight.", "pack": "FANTASY_TALK", "category": "communication", "tags": ["fantasy", "choice", "desire"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CHOICE", "durationMin": 8, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "teasing_delayed_reveal"], "excludedByBoundaries": ["comm_fantasies", "teasing_anticipation"], "chapterKinds": ["YOUR_CHOICE", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"}
