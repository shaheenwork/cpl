{
  "pack": "DEEP_TALK",
  "items": [
    {"id": "deep_noticed_first", "version": 1, "title": "What I Noticed First", "subtitle": "And when you knew.", "body": "Tell each other the first thing you noticed about the other, and the first moment you realised you wanted to see them again.", "pack": "DEEP_TALK", "category": "communication", "tags": ["memories", "compliments"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "MEMORY", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_tell_me_something", "mood_romantic"], "excludedByBoundaries": ["comm_flirting", "mood_gentle"], "chapterKinds": ["WARM_UP", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_best_day", "version": 1, "title": "Our Best Day", "subtitle": "Pick it in secret.", "body": "Each of you picks your best day together so far without telling the other. Reveal them at the same time. Did you choose the same one?", "pack": "DEEP_TALK", "category": "communication", "tags": ["memories", "prediction"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "PREDICTION", "durationMin": 10, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_tell_me_something", "mood_romantic"], "excludedByBoundaries": ["comm_flirting", "mood_gentle"], "chapterKinds": ["WARM_UP", "CURIOSITY"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_small_things", "version": 1, "title": "The Small Things", "subtitle": "The ones they think you missed.", "body": "Name three small, everyday things they do that make your life better, things they probably think you have never noticed.", "pack": "DEEP_TALK", "category": "communication", "tags": ["gratitude", "compliments"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_compliments", "mood_romantic"], "excludedByBoundaries": ["comm_flirting", "mood_gentle"], "chapterKinds": ["WARM_UP", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_ordinary_tuesday", "version": 1, "title": "An Ordinary Tuesday", "subtitle": "Five years from now.", "body": "Describe an ordinary Tuesday evening together five years from now. Where are you, what are you eating, what are you laughing about?", "pack": "DEEP_TALK", "category": "communication", "tags": ["future", "planning"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "PREDICTION", "durationMin": 10, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_shared_curiosity", "mood_romantic"], "excludedByBoundaries": ["explore_shared_curiosity", "mood_gentle"], "chapterKinds": ["CURIOSITY", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_what_helps", "version": 1, "title": "What Helps", "subtitle": "On a hard day.", "body": "Tell each other exactly what helps most on a hard day: words, space, food, touch, or something only they would guess.", "pack": "DEEP_TALK", "category": "communication", "tags": ["trust", "checkIn", "vulnerability"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 5, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_tell_me_something", "explore_trust"], "excludedByBoundaries": ["comm_flirting", "explore_trust"], "chapterKinds": ["CURIOSITY", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_our_song", "version": 1, "title": "Our Song, Right Now", "subtitle": "Back to back.", "body": "Each pick one song that sounds like your relationship right now. Play them back to back and explain why you chose it.", "pack": "DEEP_TALK", "category": "communication", "tags": ["music", "memories"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CHOICE", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["sensory_music", "mood_romantic"], "excludedByBoundaries": ["sensory_atmosphere", "mood_gentle"], "chapterKinds": ["WARM_UP", "YOUR_CHOICE"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_favourite_version", "version": 1, "title": "My Favourite Version of You", "subtitle": "Specific enough to recognise.", "body": "Describe the version of them you love most: the time of day, the mood, what they are doing. Be specific enough that they recognise it.", "pack": "DEEP_TALK", "category": "communication", "tags": ["compliments", "gratitude"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_compliments", "mood_romantic"], "excludedByBoundaries": ["comm_flirting", "mood_gentle"], "chapterKinds": ["FINALE", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_perfect_sunday", "version": 1, "title": "The Perfect Sunday", "subtitle": "Hour by hour, for free.", "body": "Plan your perfect lazy Sunday together, hour by hour, with a budget of nothing. Then claim the next free Sunday for it.", "pack": "DEEP_TALK", "category": "communication", "tags": ["planning", "date", "future"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CHOICE", "durationMin": 10, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_shared_curiosity", "mood_slow"], "excludedByBoundaries": ["explore_shared_curiosity", "mood_gentle"], "chapterKinds": ["YOUR_CHOICE", "CURIOSITY"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_guess_my_answer", "version": 1, "title": "Guess My Answer", "subtitle": "A point for every right guess.", "body": "Ask three questions about yourself, but before you answer, the other must guess what you will say. A point for every right guess.", "pack": "DEEP_TALK", "category": "communication", "tags": ["prediction", "game", "laughter"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "PREDICTION", "durationMin": 10, "moods": ["unpredictable", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_tell_me_something", "teasing_playful_challenges"], "excludedByBoundaries": ["comm_flirting", "teasing_games"], "chapterKinds": ["CURIOSITY", "CHALLENGE"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_thank_you_note", "version": 1, "title": "A Thank-You Note", "subtitle": "Overdue, and meant.", "body": "Write them a short thank-you note for something they did that you never properly thanked them for. Send it tonight.", "pack": "DEEP_TALK", "category": "communication", "tags": ["letter", "gratitude"], "intensity": 1, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 10, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_compliments", "mood_romantic"], "excludedByBoundaries": ["comm_flirting", "mood_gentle"], "chapterKinds": ["FINALE", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_our_list", "version": 1, "title": "Our List", "subtitle": "Ten things, then the first.", "body": "Start a shared list of ten things you want to do together before the end of next year. Pick the first one tonight.", "pack": "DEEP_TALK", "category": "communication", "tags": ["future", "planning", "adventure"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["romantic", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_adventure", "explore_shared_curiosity"], "excludedByBoundaries": ["explore_novelty", "explore_shared_curiosity"], "chapterKinds": ["CURIOSITY", "YOUR_CHOICE"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_most_at_home", "version": 1, "title": "Most at Home", "subtitle": "The time, the place, the light.", "body": "Describe the moment in an ordinary week when you feel most at home with them. Be specific about the time, the place and the light.", "pack": "DEEP_TALK", "category": "communication", "tags": ["vulnerability", "gratitude"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_romantic", "comm_tell_me_something"], "excludedByBoundaries": ["mood_gentle", "comm_flirting"], "chapterKinds": ["WARM_UP", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_changed_my_mind", "version": 1, "title": "Changed My Mind", "subtitle": "Because of them.", "body": "Tell them one opinion you changed because of them, and one you are still quietly hoping to change their mind about.", "pack": "DEEP_TALK", "category": "communication", "tags": ["laughter", "memories"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 5, "moods": ["talk", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_secrets", "comm_tell_me_something"], "excludedByBoundaries": ["comm_confessions", "comm_flirting"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_small_fear", "version": 1, "title": "A Small Fear", "subtitle": "No fixing, no advice.", "body": "Share one small fear about the future that you have not said out loud. The listener only listens: no fixing and no advice.", "pack": "DEEP_TALK", "category": "communication", "tags": ["vulnerability", "trust", "future"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust", "comm_secrets"], "excludedByBoundaries": ["explore_trust", "comm_confessions"], "chapterKinds": ["CONFESSION"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_feel_loved", "version": 1, "title": "How You Feel Loved", "subtitle": "Guess first.", "body": "Each guess how the other most likes to be shown love. Then say what you really need, and one small thing that would mean more than they think.", "pack": "DEEP_TALK", "category": "communication", "tags": ["prediction", "trust"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "PREDICTION", "durationMin": 10, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_tell_me_something", "explore_trust"], "excludedByBoundaries": ["comm_flirting", "explore_trust"], "chapterKinds": ["CURIOSITY", "CONFESSION"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_hardest_week", "version": 1, "title": "The Hardest Week", "subtitle": "And what got you through.", "body": "Talk about the hardest week you have had as a couple, and what each of you did that got you both through it.", "pack": "DEEP_TALK", "category": "communication", "tags": ["memories", "trust", "gratitude"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "MEMORY", "durationMin": 10, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust", "comm_storytelling"], "excludedByBoundaries": ["explore_trust", "comm_fantasies"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_quiet_hope", "version": 1, "title": "A Quiet Hope", "subtitle": "Almost too big to say.", "body": "Tell them one hope for your life together that feels almost too big to say. Then they tell you one of theirs.", "pack": "DEEP_TALK", "category": "communication", "tags": ["future", "vulnerability"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_secrets", "mood_romantic"], "excludedByBoundaries": ["comm_confessions", "mood_gentle"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_out_of_ten", "version": 1, "title": "Out of Ten", "subtitle": "What would make it eleven?", "body": "Rate your week together out of ten and explain the score. Then each say what would have made it an eleven.", "pack": "DEEP_TALK", "category": "communication", "tags": ["checkIn", "gratitude"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["talk", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust", "comm_tell_me_something"], "excludedByBoundaries": ["explore_trust", "comm_flirting"], "chapterKinds": ["WARM_UP", "CURIOSITY"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_long_message", "version": 1, "title": "The Long Message", "subtitle": "The one you've been composing.", "body": "Write them the long message you have been composing in your head for weeks. Send it without editing it more than once.", "pack": "DEEP_TALK", "category": "communication", "tags": ["message", "vulnerability", "letter"], "intensity": 2, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 15, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_tell_me_something", "comm_secrets"], "excludedByBoundaries": ["comm_flirting", "comm_confessions"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_you_taught_me", "version": 1, "title": "What You Taught Me", "subtitle": "On purpose or by accident.", "body": "Tell them one thing they taught you, on purpose or by accident, that you now do without even thinking.", "pack": "DEEP_TALK", "category": "communication", "tags": ["gratitude", "memories"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_compliments", "comm_tell_me_something"], "excludedByBoundaries": ["comm_flirting"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_how_would_i_react", "version": 1, "title": "How Would I React?", "subtitle": "Scored out of three.", "body": "Describe three surprising situations. The other predicts exactly how you would react to each. Score every guess out of three.", "pack": "DEEP_TALK", "category": "communication", "tags": ["prediction", "game", "laughter"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "PREDICTION", "durationMin": 10, "moods": ["unpredictable", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["teasing_playful_challenges", "comm_tell_me_something"], "excludedByBoundaries": ["teasing_games", "comm_flirting"], "chapterKinds": ["CURIOSITY", "CHALLENGE"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_unfinished_business", "version": 1, "title": "Unfinished Business", "subtitle": "Do it or let it go.", "body": "Name one thing you always meant to do together and never did. Decide tonight whether to do it this month or let it go for good.", "pack": "DEEP_TALK", "category": "communication", "tags": ["planning", "future"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CHOICE", "durationMin": 10, "moods": ["talk", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_shared_curiosity", "explore_adventure"], "excludedByBoundaries": ["explore_shared_curiosity", "explore_novelty"], "chapterKinds": ["YOUR_CHOICE", "CURIOSITY"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_memory_told", "version": 1, "title": "A Memory, Told", "subtitle": "As if they weren't there.", "body": "Send them a voice note telling a favourite memory of the two of you, as though describing it to someone who was not there.", "pack": "DEEP_TALK", "category": "communication", "tags": ["voice", "memories", "storytelling"], "intensity": 2, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_voice", "comm_storytelling"], "excludedByBoundaries": ["comm_voice", "comm_fantasies"], "chapterKinds": ["WARM_UP", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_the_trip", "version": 1, "title": "The Trip We'll Take", "subtitle": "One minute to argue for it.", "body": "Each choose one place in the world to go together and argue for it in under a minute. Whoever wins, the other plans the first day.", "pack": "DEEP_TALK", "category": "communication", "tags": ["adventure", "planning", "future"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CHOICE", "durationMin": 10, "moods": ["unpredictable", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_adventure", "teasing_playful_challenges"], "excludedByBoundaries": ["explore_novelty", "teasing_games"], "chapterKinds": ["YOUR_CHOICE", "CHALLENGE"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_almost_said", "version": 1, "title": "What I Almost Said", "subtitle": "Say it now.", "body": "Tell them about a moment you almost said something important to them and didn't. Then say it now.", "pack": "DEEP_TALK", "category": "communication", "tags": ["confession", "vulnerability"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 5, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_secrets", "comm_confessions"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_need_more_of", "version": 1, "title": "More Of", "subtitle": "Kind and specific.", "body": "Each name one thing you need more of from the relationship, and one thing you could give more of. Keep it kind and specific.", "pack": "DEEP_TALK", "category": "communication", "tags": ["checkIn", "trust"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust", "comm_tell_me_something"], "excludedByBoundaries": ["explore_trust", "comm_flirting"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_desire_then_now", "version": 1, "title": "Desire, Then and Now", "subtitle": "What grew, what you miss.", "body": "Talk about how your desire for each other has changed since you met: what has grown, and what you miss from the very beginning.", "pack": "DEEP_TALK", "category": "communication", "tags": ["desire", "vulnerability", "memories"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 15, "moods": ["talk", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_naughty", "explore_trust"], "excludedByBoundaries": ["mood_charged", "explore_trust"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_love_explained", "version": 1, "title": "Love, Explained", "subtitle": "No clichés allowed.", "body": "Write them a message explaining exactly why you love them, as if they had asked you to prove it. No clichés allowed.", "pack": "DEEP_TALK", "category": "communication", "tags": ["letter", "compliments", "message"], "intensity": 3, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 15, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_compliments", "mood_romantic"], "excludedByBoundaries": ["comm_flirting", "mood_gentle"], "chapterKinds": ["FINALE", "CONFESSION"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_when_i_knew", "version": 1, "title": "The Moment of Trust", "subtitle": "That you could trust them.", "body": "Tell each other the moment you knew you could trust them completely, and ask whether they realised it at the time.", "pack": "DEEP_TALK", "category": "communication", "tags": ["memories", "trust"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "MEMORY", "durationMin": 10, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust", "comm_storytelling"], "excludedByBoundaries": ["explore_trust", "comm_fantasies"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_argue_better", "version": 1, "title": "Argue Better", "subtitle": "Agree the pause signal.", "body": "Talk about how you argue. Name one habit each of you would like to change, and agree one signal that means let's pause.", "pack": "DEEP_TALK", "category": "communication", "tags": ["checkIn", "trust"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 15, "moods": ["talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust"], "excludedByBoundaries": ["explore_trust"], "chapterKinds": ["CURIOSITY", "CONFESSION"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_private_version", "version": 1, "title": "The Private Version", "subtitle": "Almost nobody sees it.", "body": "Tell them about a side of yourself almost nobody sees, and about the last time you let it out.", "pack": "DEEP_TALK", "category": "communication", "tags": ["secrets", "vulnerability"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["talk", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_secrets", "explore_trust"], "excludedByBoundaries": ["comm_confessions", "explore_trust"], "chapterKinds": ["CONFESSION"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_letter_to_next_year", "version": 1, "title": "A Letter to Next Year", "subtitle": "Sealed until then.", "body": "Write a letter together to yourselves one year from now: what you hope has changed, and what you hope never will. Seal it.", "pack": "DEEP_TALK", "category": "communication", "tags": ["letter", "future", "ritual"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "MESSAGE", "durationMin": 15, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_shared_curiosity", "teasing_delayed_reveal"], "excludedByBoundaries": ["explore_shared_curiosity", "teasing_anticipation"], "chapterKinds": ["FINALE", "YOUR_CHOICE"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_closer", "version": 1, "title": "Closer", "subtitle": "With and without a touch.", "body": "Tell each other one thing that makes you feel closer to them physically, and one that makes you feel closer without a single touch.", "pack": "DEEP_TALK", "category": "communication", "tags": ["touch", "trust", "desire"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust", "mood_naughty"], "excludedByBoundaries": ["explore_trust", "mood_charged"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_what_distance_does", "version": 1, "title": "What Distance Does", "subtitle": "Harder, and easier.", "body": "On a call, talk honestly about what time apart does to you: what gets harder, and what surprisingly gets easier.", "pack": "DEEP_TALK", "category": "communication", "tags": ["distance", "vulnerability", "checkIn"], "intensity": 3, "modes": ["APART"], "interactionType": "CONVERSATION", "durationMin": 15, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust", "comm_tell_me_something"], "excludedByBoundaries": ["explore_trust", "comm_flirting"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_small_regret", "version": 1, "title": "One Small Regret", "subtitle": "And what they remember.", "body": "Share one small regret from your time together, something you would do differently, and let them tell you what they remember instead.", "pack": "DEEP_TALK", "category": "communication", "tags": ["vulnerability", "memories"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_secrets", "explore_trust"], "excludedByBoundaries": ["comm_confessions", "explore_trust"], "chapterKinds": ["CONFESSION"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_deepest_want", "version": 1, "title": "The Deepest Want", "subtitle": "The one that matters too much.", "body": "Tell them the thing you want most from your life together, the one you rarely say because it matters too much.", "pack": "DEEP_TALK", "category": "communication", "tags": ["vulnerability", "future", "desire"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_secrets", "explore_trust"], "excludedByBoundaries": ["comm_confessions", "explore_trust"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_never_asked", "version": 1, "title": "The Question I Never Asked", "subtitle": "Take a minute before answering.", "body": "Ask them the question you have wanted to ask for a long time and never dared to. They can take a minute before they answer.", "pack": "DEEP_TALK", "category": "communication", "tags": ["vulnerability", "confession", "trust"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["talk", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_secrets", "explore_trust"], "excludedByBoundaries": ["comm_confessions", "explore_trust"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_when_i_want_you", "version": 1, "title": "When I Want You Most", "subtitle": "Not in bed.", "body": "Tell each other the specific moments, not in bed, when you want them most: a look, a sentence, a way they move across a room.", "pack": "DEEP_TALK", "category": "communication", "tags": ["desire", "compliments"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_naughty", "comm_compliments"], "excludedByBoundaries": ["mood_charged", "comm_flirting"], "chapterKinds": ["TEASE", "CONFESSION"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_ask_for_it", "version": 1, "title": "Ask for It", "subtitle": "Plainly.", "body": "Ask for one thing you need from them, emotional or physical, that you have been waiting for them to guess. Say it plainly.", "pack": "DEEP_TALK", "category": "communication", "tags": ["vulnerability", "trust", "desire"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["talk", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust", "comm_secrets"], "excludedByBoundaries": ["explore_trust", "comm_confessions"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_honest_letter", "version": 1, "title": "The Honest Letter", "subtitle": "End with a promise.", "body": "Write them an honest letter about where you are as a couple: what is wonderful, what is hard, and what you want next. End with a promise.", "pack": "DEEP_TALK", "category": "communication", "tags": ["letter", "vulnerability", "future"], "intensity": 4, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 20, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust", "comm_tell_me_something"], "excludedByBoundaries": ["explore_trust", "comm_flirting"], "chapterKinds": ["FINALE", "CONFESSION"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_what_i_see", "version": 1, "title": "What I See", "subtitle": "The parts they doubt included.", "body": "Tell them what you see when you look at them, including the parts they doubt most. Then ask what they see in you.", "pack": "DEEP_TALK", "category": "communication", "tags": ["compliments", "vulnerability", "eyeContact"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_compliments", "explore_trust"], "excludedByBoundaries": ["comm_flirting", "explore_trust"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_why_that_fantasy", "version": 1, "title": "Why That Fantasy", "subtitle": "The feeling, not the details.", "body": "Pick a fantasy one of you has mentioned before and talk about why it appeals: the feeling behind it, not the details.", "pack": "DEEP_TALK", "category": "communication", "tags": ["fantasy", "vulnerability"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 15, "moods": ["talk", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_fantasies", "explore_trust"], "excludedByBoundaries": ["comm_fantasies", "explore_trust"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_what_scares_me", "version": 1, "title": "What Scares Me About Us", "subtitle": "And what would help.", "body": "Each say one thing that scares you about how much you love them. Then say what would help.", "pack": "DEEP_TALK", "category": "communication", "tags": ["vulnerability", "trust"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_trust", "comm_secrets"], "excludedByBoundaries": ["explore_trust", "comm_confessions"], "chapterKinds": ["CONFESSION"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_three_promises", "version": 1, "title": "Three Promises", "subtitle": "Practical, romantic, after dark.", "body": "Make each other three promises for the coming year: one practical, one romantic, and one just for the two of you after dark.", "pack": "DEEP_TALK", "category": "communication", "tags": ["future", "ritual", "desire"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["mood_romantic", "explore_trust"], "excludedByBoundaries": ["mood_gentle", "explore_trust"], "chapterKinds": ["FINALE", "YOUR_CHOICE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "deep_if_you_were_here", "version": 1, "title": "The Honest Voice Note", "subtitle": "Honest, not clever.", "body": "Record a voice note with the thing you would say tonight if they were beside you with the lights off. Make it honest, not clever.", "pack": "DEEP_TALK", "category": "communication", "tags": ["voice", "vulnerability", "bedtime"], "intensity": 4, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_voice", "comm_secrets"], "excludedByBoundaries": ["comm_voice", "comm_confessions"], "chapterKinds": ["FINALE", "CONFESSION"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"}
  ]
