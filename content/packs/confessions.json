{
  "pack": "CONFESSIONS",
  "items": [
    {"id": "confess_first_impression", "version": 1, "title": "First Impression", "subtitle": "Be honest. It's funnier.", "body": "Confess what you honestly thought of them the first time you met, including the part you have never admitted.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "memories", "laughter"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["WARM_UP", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_tiny_habit", "version": 1, "title": "The Tiny Habit", "subtitle": "The one you secretly love.", "body": "Confess one tiny habit of theirs you pretend to find annoying but secretly love. Say what it does to you.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "compliments"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["WARM_UP", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_almost_said", "version": 1, "title": "The Almost-Said", "subtitle": "Early on.", "body": "Tell them about a moment early on when you almost said something big and chickened out. What were you going to say?", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "memories", "vulnerability"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_secret_rehearsal", "version": 1, "title": "The Rehearsal", "subtitle": "You practised it, didn't you?", "body": "Confess something you once rehearsed saying to them before you actually said it. Perform the rehearsed version now.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "laughter", "memories"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["talk", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_playful"], "excludedByBoundaries": ["comm_confessions", "mood_gentle"], "chapterKinds": ["CONFESSION", "WILDCARD"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_jealous_of_what", "version": 1, "title": "Small Jealousy", "subtitle": "Harmless, and true.", "body": "Confess one completely harmless thing you are a little jealous of: their laugh, their patience, the way they sleep through anything.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "compliments"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["WARM_UP", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_the_screenshot", "version": 1, "title": "The Screenshot", "subtitle": "You kept it.", "body": "Confess a message of theirs you saved, screenshotted or read more than once. Send it back to them now.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "memories", "message"], "intensity": 1, "modes": ["APART"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_guilty_pleasure", "version": 1, "title": "Guilty Pleasure", "subtitle": "The ridiculous one.", "body": "Confess your most ridiculous guilty pleasure, the one you would deny in company. They have to confess one back.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "laughter"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["talk", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_secrets"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["WARM_UP", "WILDCARD"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_when_i_knew", "version": 1, "title": "When I Knew", "subtitle": "The exact moment.", "body": "Tell them the exact moment you knew you were in trouble with them, in the best way. Where were you? What were they doing?", "pack": "CONFESSIONS", "category": "communication", "tags": ["memories", "confession", "vulnerability"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "MEMORY", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_romantic"], "excludedByBoundaries": ["comm_confessions", "mood_gentle"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_secret_nickname_confession", "version": 1, "title": "What I Call You", "subtitle": "In my head.", "body": "Confess what you call them in your head when they are not listening. Explain yourself.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "laughter"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["talk", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_secrets", "mood_playful"], "excludedByBoundaries": ["comm_confessions", "mood_gentle"], "chapterKinds": ["WARM_UP", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_worst_first_date_moment", "version": 1, "title": "My Worst Moment", "subtitle": "On our early dates.", "body": "Confess the moment on one of your early dates when you were most sure you had ruined everything. Were you right?", "pack": "CONFESSIONS", "category": "communication", "tags": ["memories", "confession", "laughter"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "MEMORY", "durationMin": 5, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "WARM_UP"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_voice_confession_small", "version": 1, "title": "Small Truth, Out Loud", "subtitle": "Easier to say than type.", "body": "Record a short voice message confessing one small truth you have never got round to saying. Keep it under a minute.", "pack": "CONFESSIONS", "category": "communication", "tags": ["voice", "confession"], "intensity": 1, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 3, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_voice"], "excludedByBoundaries": ["comm_confessions", "comm_voice"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_stared_at", "version": 1, "title": "What I Stare At", "subtitle": "When they're not looking.", "body": "Confess what you catch yourself staring at when they are not looking. Be specific. They will want to check.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "eyeContact"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_flirty"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_the_outfit", "version": 1, "title": "That Outfit", "subtitle": "You know the one.", "body": "Confess which thing they wear that you find most distracting, and one occasion it made you lose your train of thought.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "compliments"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["naughty", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_flirty"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_daydream", "version": 1, "title": "The Daydream", "subtitle": "At the worst possible moment.", "body": "Confess the last time you daydreamed about them at a completely inappropriate moment. Where were you supposed to be concentrating?", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "laughter"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_flirty"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_first_crush_moment", "version": 1, "title": "First Flutter", "subtitle": "Before anything happened.", "body": "Confess the first moment you felt a flutter about them, before anything had happened between you. What gave it away?", "pack": "CONFESSIONS", "category": "communication", "tags": ["memories", "confession"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "MEMORY", "durationMin": 4, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_romantic"], "excludedByBoundaries": ["comm_confessions", "mood_gentle"], "chapterKinds": ["CONFESSION", "WARM_UP"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_secret_wish_for_us", "version": 1, "title": "A Wish for Us", "subtitle": "Small or huge.", "body": "Confess one wish for the two of you that you have never said out loud because it felt too soon, too big, or too silly.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "future", "vulnerability"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 5, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_what_i_replay", "version": 1, "title": "The Replay", "subtitle": "The moment you keep reliving.", "body": "Confess a moment between you that you replay in your head more often than you would admit. Tell it from your side.", "pack": "CONFESSIONS", "category": "communication", "tags": ["memories", "confession", "desire"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "MEMORY", "durationMin": 5, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_secrets"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_by_message", "version": 1, "title": "Anonymous-ish", "subtitle": "Type it. Send it. Hide.", "body": "Message them a confession you would find hard to say to their face. Then put your phone down for five minutes.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "message", "vulnerability"], "intensity": 2, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 6, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_secrets"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "WILDCARD"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_which_kiss", "version": 1, "title": "The Kiss I Remember", "subtitle": "One stands out.", "body": "Confess which kiss between you stands out most in your memory, and the detail about it you have never mentioned.", "pack": "CONFESSIONS", "category": "communication", "tags": ["kissing", "memories", "confession"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "MEMORY", "durationMin": 4, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_romantic"], "excludedByBoundaries": ["comm_confessions", "mood_gentle"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_pretend_not_to_notice", "version": 1, "title": "Pretending Not to Notice", "subtitle": "You noticed.", "body": "Confess something they do that you pretend not to notice but absolutely do, every single time.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_two_truths_confession", "version": 1, "title": "True or Invented", "subtitle": "Confess three. One is made up.", "body": "Confess three things about how you feel about them. One is invented. They have to work out which, and why you would lie about it.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "game", "prediction"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "PREDICTION", "durationMin": 6, "moods": ["talk", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "teasing_playful_challenges"], "excludedByBoundaries": ["comm_confessions", "teasing_games"], "chapterKinds": ["CURIOSITY", "WILDCARD"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_thought_about_it", "version": 1, "title": "I Thought About It", "subtitle": "Earlier today.", "body": "Confess one moment today when you thought about them in a way that would make them blush. Describe it only as far as you dare.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_naughty"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_most_distracting_thing", "version": 1, "title": "Most Distracting", "subtitle": "Top of the list.", "body": "Confess the single most distracting thing they have ever done without meaning to. Tell them what went through your head.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_naughty"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_secret_request", "version": 1, "title": "The Unasked Request", "subtitle": "Something you never asked for.", "body": "Confess one thing you would love them to do more often that you have never asked for. They answer only with 'noted'.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "checkIn"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "explore_shared_curiosity"], "excludedByBoundaries": ["comm_confessions", "explore_shared_curiosity"], "chapterKinds": ["CONFESSION", "YOUR_CHOICE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_the_dream", "version": 1, "title": "The Dream", "subtitle": "The one about them.", "body": "Confess a dream you had about them. Tell them as much of it as you are willing to, and let them guess the rest.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "storytelling"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 5, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_secrets"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_what_i_wanted_then", "version": 1, "title": "What I Wanted Then", "subtitle": "At a certain dinner.", "body": "Confess a time you were out together, perfectly polite, while thinking about something entirely different. What were you thinking?", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "memories"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_naughty"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "WILDCARD"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_confession_whisper", "version": 1, "title": "Whispered Confession", "subtitle": "Say it only once.", "body": "Whisper one confession you would never say at normal volume. You say it once. They are not allowed to ask you to repeat it.", "pack": "CONFESSIONS", "category": "communication", "tags": ["whisper", "confession", "desire"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "CONFESSION", "durationMin": 2, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "teasing_verbal"], "excludedByBoundaries": ["comm_confessions", "teasing_words"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_the_look_you_give", "version": 1, "title": "That Look", "subtitle": "You know which one.", "body": "Confess what you are thinking when you give them that particular look, the one they have asked about before.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "eyeContact", "desire"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_secrets"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_voice_confession_bold", "version": 1, "title": "Say It in Your Voice", "subtitle": "Recorded, not typed.", "body": "Record a voice message confessing the boldest thing you have thought about them this week. They listen alone.", "pack": "CONFESSIONS", "category": "communication", "tags": ["voice", "confession", "desire"], "intensity": 3, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 3, "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_voice"], "excludedByBoundaries": ["comm_confessions", "comm_voice"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_rate_my_confession", "version": 1, "title": "Rate the Confession", "subtitle": "One to ten.", "body": "Take turns making confessions. The other rates each one from 'mild' to 'I need a moment'. Keep going until someone reaches ten.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "game", "laughter"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "CHALLENGE", "durationMin": 10, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "teasing_playful_challenges"], "excludedByBoundaries": ["comm_confessions", "teasing_games"], "chapterKinds": ["CHALLENGE", "CONFESSION"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_secret_compliment", "version": 1, "title": "The Compliment I Kept", "subtitle": "Too much at the time.", "body": "Confess a compliment you once thought about them and kept to yourself because it felt like too much. Say it now.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "compliments", "desire"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["naughty", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_compliments"], "excludedByBoundaries": ["comm_confessions", "comm_flirting"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_what_i_never_asked", "version": 1, "title": "Never Asked For", "subtitle": "Until now.", "body": "Confess one thing you have wanted to try with them and never asked for. They answer honestly: yes, maybe, or not for me.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "checkIn"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 5, "moods": ["bold", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "explore_something_new"], "excludedByBoundaries": ["comm_confessions", "explore_novelty"], "chapterKinds": ["CONFESSION", "YOUR_CHOICE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_bold_memory", "version": 1, "title": "The Night I Still Think About", "subtitle": "In detail, if you dare.", "body": "Confess which night together you still think about most, and exactly which moment of it comes back to you.", "pack": "CONFESSIONS", "category": "communication", "tags": ["memories", "confession", "desire"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "MEMORY", "durationMin": 5, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_intense"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_in_the_dark", "version": 1, "title": "In the Dark", "subtitle": "Lights off. Truth on.", "body": "Turn the lights off. Take turns confessing something you want from the other that you would not say with the lights on.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "lighting"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONFESSION", "durationMin": 8, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "sensory_lighting"], "excludedByBoundaries": ["comm_confessions", "sensory_atmosphere"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_what_drives_me_wild", "version": 1, "title": "What Drives Me Wild", "subtitle": "Number one.", "body": "Confess the single thing they do that drives you wildest. Then confess when they last did it, and whether they knew.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_intense"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_hidden_wish_list", "version": 1, "title": "The Hidden List", "subtitle": "Three items. Real ones.", "body": "Write down three bold things you would like to share with them someday. Read one aloud now. The other two wait for another night.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "future"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 6, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_secrets"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "WILDCARD"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_the_thought_i_hide", "version": 1, "title": "The Thought I Hide", "subtitle": "Right now, in this room.", "body": "Confess what you are actually thinking about them right now, this minute, without softening a word of it.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_intense"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_secret_by_message_bold", "version": 1, "title": "The Message You Delete", "subtitle": "Send it this time.", "body": "Confess, by message, something you have typed to them before and deleted without sending. Send it this time.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "message", "vulnerability"], "intensity": 4, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 4, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_secrets"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_and_ask", "version": 1, "title": "Confess and Ask", "subtitle": "Then they answer.", "body": "Confess one thing you want and ask one question you have been afraid to ask. They must answer the question before the night ends.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "checkIn"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 6, "moods": ["bold", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "explore_trust"], "excludedByBoundaries": ["comm_confessions", "explore_trust"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_tell_me_the_truth", "version": 1, "title": "Tell Me the Truth", "subtitle": "They pick the question.", "body": "They ask you one bold question of their choosing. You must answer truthfully or give them a kiss that explains why you won't.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "choice", "kissing"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CHOICE", "durationMin": 5, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "teasing_surprise_choices"], "excludedByBoundaries": ["comm_confessions", "teasing_games"], "chapterKinds": ["YOUR_CHOICE", "CONFESSION"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_the_fantasy_i_mentioned", "version": 1, "title": "Something I Imagined", "subtitle": "Said out loud for once.", "body": "Confess one scene you have imagined about the two of you, in as much detail as feels good, and not a word more.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "fantasy"], "intensity": 4, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 6, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_fantasies"], "excludedByBoundaries": ["comm_confessions", "comm_fantasies"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_boldest_truth", "version": 1, "title": "The Boldest Truth", "subtitle": "No taking it back.", "body": "Confess the boldest true thing you have ever thought about them. No softening, no joke at the end, no taking it back.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire"], "intensity": 5, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_intense"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_confession_for_confession", "version": 1, "title": "Trade", "subtitle": "One for one. Bigger each time.", "body": "Trade confessions, one for one, each bolder than the last. Either of you can stop the trade at any time, no questions asked.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "checkIn"], "intensity": 5, "modes": ["TOGETHER", "APART"], "interactionType": "CHALLENGE", "durationMin": 10, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_secrets"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_the_one_you_wont_say", "version": 1, "title": "The One You Won't Say", "subtitle": "Say it anyway.", "body": "Everyone has one thing they would never say to their partner. Say yours, as gently or as boldly as it needs.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "vulnerability", "desire"], "intensity": 5, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 5, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_secrets"], "excludedByBoundaries": ["comm_confessions"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_what_you_want_now", "version": 1, "title": "What I Want Now", "subtitle": "Present tense.", "body": "Confess what you want from them in the next ten minutes, specifically and out loud. They decide whether you get it.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "choice"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONFESSION", "durationMin": 3, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "power_partner_decides"], "excludedByBoundaries": ["comm_confessions", "power_yielding"], "chapterKinds": ["CONFESSION", "YOUR_CHOICE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_late_confession", "version": 1, "title": "After Midnight", "subtitle": "The things that only get said late.", "body": "After midnight, message them the thing you only admit late at night. They reply in the morning, in person.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "message", "bedtime"], "intensity": 5, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 5, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_intense"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_the_limit", "version": 1, "title": "My Limit, and Past It", "subtitle": "Know both.", "body": "Confess one thing that is firmly outside your limits and one thing that sits right at the edge of them. Neither needs a reason.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "checkIn", "trust"], "intensity": 5, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 6, "moods": ["bold", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "explore_trust"], "excludedByBoundaries": ["comm_confessions", "explore_trust"], "chapterKinds": ["CONFESSION", "CURIOSITY"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_voice_confession_wild", "version": 1, "title": "Unedited", "subtitle": "Record it in one take.", "body": "Record one take, no restarts, confessing exactly what you want from them next time. Send it before you can talk yourself out of it.", "pack": "CONFESSIONS", "category": "communication", "tags": ["voice", "confession", "desire"], "intensity": 5, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 3, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_voice"], "excludedByBoundaries": ["comm_confessions", "comm_voice"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_eyes_closed_confession", "version": 1, "title": "Closed Eyes, Open Secret", "subtitle": "Theirs, not yours.", "body": "They close their eyes. You confess one thing you want to do to them, and then decide whether to do it.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONFESSION", "durationMin": 5, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "teasing_anticipation"], "excludedByBoundaries": ["comm_confessions", "teasing_anticipation"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_the_full_truth", "version": 1, "title": "The Full Truth", "subtitle": "About tonight.", "body": "Confess the full truth about what you have been imagining for tonight. Then ask them for theirs.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire", "fantasy"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONFESSION", "durationMin": 6, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "comm_fantasies"], "excludedByBoundaries": ["comm_confessions", "comm_fantasies"], "chapterKinds": ["CONFESSION", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_secret_after_secret", "version": 1, "title": "Deeper", "subtitle": "Keep going if you both want to.", "body": "Confess a secret. They confess one slightly deeper. Keep going while you both want to; either can end it with a kiss.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "secrets", "kissing"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CHALLENGE", "durationMin": 10, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_secrets", "mood_intense"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "WILDCARD"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "confess_what_you_dont_know", "version": 1, "title": "What You Don't Know", "subtitle": "About how much I want you.", "body": "Confess the thing they do not know about how much you want them: when it hits hardest, and what you do about it.", "pack": "CONFESSIONS", "category": "communication", "tags": ["confession", "desire"], "intensity": 5, "modes": ["TOGETHER", "APART"], "interactionType": "CONFESSION", "durationMin": 4, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["comm_confessions", "mood_intense"], "excludedByBoundaries": ["comm_confessions", "mood_charged"], "chapterKinds": ["CONFESSION", "TEASE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"}
  ]
}
