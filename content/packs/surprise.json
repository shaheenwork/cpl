    {"id": "surprise_flirty_surprise_note", "version": 1, "title": "The Note in Their Bag", "subtitle": "They'll find it at work.", "body": "Tuck a note into their bag that they will find in the middle of an ordinary day. One line. Bold enough to make them blush.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "letter", "desire"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 3, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "mood_flirty"], "excludedByBoundaries": ["explore_surprise", "mood_charged"], "chapterKinds": ["TEASE", "WILDCARD"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_voice_surprise", "version": 1, "title": "Out of Nowhere", "subtitle": "A voice message they don't expect.", "body": "In the middle of their day, send a thirty-second voice message saying one thing you love about them and one thing you are looking forward to tonight.", "pack": "SURPRISE", "category": "exploration", "tags": ["voice", "surprise", "anticipation"], "intensity": 2, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 3, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "comm_voice"], "excludedByBoundaries": ["explore_surprise", "comm_voice"], "chapterKinds": ["WILDCARD", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
