    {"id": "surprise_secret_upgrade", "version": 1, "title": "The Upgrade", "subtitle": "An ordinary evening, improved.", "body": "Take an ordinary evening you already planned and quietly upgrade one part of it: a better dessert, a view, a song. Watch them notice.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "date", "gift"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 10, "moods": ["romantic", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised"], "excludedByBoundaries": ["explore_surprise"], "chapterKinds": ["WILDCARD", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_outfit", "version": 1, "title": "What's Underneath", "subtitle": "They'll find out later.", "body": "Tell them in the morning that you are wearing something for them under your clothes today. Refuse every question until tonight.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "anticipation", "costume"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "SURPRISE", "durationMin": 2, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "teasing_delayed_reveal"], "excludedByBoundaries": ["explore_surprise", "teasing_anticipation"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
