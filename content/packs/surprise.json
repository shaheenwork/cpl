    {"id": "surprise_breakfast_ambush", "version": 1, "title": "Breakfast Ambush", "subtitle": "Before they're awake.", "body": "Make tomorrow's breakfast a surprise: their favourite thing, a note on the plate, and one line about what you love about their mornings.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "morning", "gift"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 20, "moods": ["romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "mood_romantic"], "excludedByBoundaries": ["explore_surprise", "mood_gentle"], "chapterKinds": ["WILDCARD", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_hidden_notes", "version": 1, "title": "Hidden Notes", "subtitle": "Five of them.", "body": "Hide five small notes where they will find them over the next week: a coat pocket, a book, the fridge. Each one a different reason.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "letter", "compliments"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 10, "moods": ["romantic", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "comm_compliments"], "excludedByBoundaries": ["explore_surprise", "comm_flirting"], "chapterKinds": ["WILDCARD", "WARM_UP"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_delivery", "version": 1, "title": "Something at the Door", "subtitle": "Sent from afar.", "body": "Have something small delivered to them without warning: their favourite snack, a flower, a book. Include a note with no signature.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "gift", "distance"], "intensity": 1, "modes": ["APART"], "interactionType": "SURPRISE", "durationMin": 10, "moods": ["romantic", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised"], "excludedByBoundaries": ["explore_surprise"], "chapterKinds": ["WILDCARD", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_pick_the_evening", "version": 1, "title": "Mystery Evening", "subtitle": "Wear something nice.", "body": "Plan a mystery evening for next week that you know they'll love. Tonight, tell them only the time and what to wear, and nothing else.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "date", "mysteryDate"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 10, "moods": ["romantic", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "roleplay_mystery_date"], "excludedByBoundaries": ["explore_surprise", "roleplay_mystery_date"], "chapterKinds": ["WILDCARD", "YOUR_CHOICE"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_memory_surprise", "version": 1, "title": "Remember This?", "subtitle": "A photo from before.", "body": "Send them a photo from early in your relationship they have forgotten you took, with one line about what you were thinking that day.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "memories", "photo"], "intensity": 1, "modes": ["APART"], "interactionType": "SURPRISE", "durationMin": 5, "moods": ["romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised"], "excludedByBoundaries": ["explore_surprise"], "chapterKinds": ["WARM_UP", "CONFESSION"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": "PHOTO", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_favourite_song_surprise", "version": 1, "title": "Unexpected Song", "subtitle": "Playing as they walk in.", "body": "Have a song that means something to both of you playing, not too loud, the next time they walk through the door.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "music", "memories"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 5, "moods": ["romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "sensory_music"], "excludedByBoundaries": ["explore_surprise", "sensory_atmosphere"], "chapterKinds": ["WARM_UP", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
