    {"id": "surprise_bold_plan", "version": 1, "title": "Tonight, Decided", "subtitle": "They find out on arrival.", "body": "Plan the rest of tonight entirely on your own, inside the limits you both know. They find out what each part is only as it begins.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "planning", "trust"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 30, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "power_direct_the_evening"], "excludedByBoundaries": ["explore_surprise", "power_leading"], "chapterKinds": ["FINALE", "CONTROL"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_voice_bold", "version": 1, "title": "The Voice Message", "subtitle": "Timed for when they're alone.", "body": "Send a voice message timed for when you know they will be alone, telling them exactly what you want next time. Keep it under two minutes.", "pack": "SURPRISE", "category": "exploration", "tags": ["voice", "surprise", "desire"], "intensity": 4, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 3, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "comm_voice"], "excludedByBoundaries": ["explore_surprise", "comm_voice"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_envelope_bold", "version": 1, "title": "The Sealed Evening", "subtitle": "Opened on arrival.", "body": "Hand them a sealed envelope describing tonight in detail. They open it only when you both walk through the door.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "letter", "anticipation"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "REVEAL", "durationMin": 10, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "teasing_delayed_reveal"], "excludedByBoundaries": ["explore_surprise", "teasing_anticipation"], "chapterKinds": ["TEASE", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_them_mid_day", "version": 1, "title": "Midday", "subtitle": "Bold, then gone.", "body": "Call them in the middle of their day, say one bold sentence about tonight, and hang up before they can answer.", "pack": "SURPRISE", "category": "exploration", "tags": ["voice", "surprise", "desire"], "intensity": 4, "modes": ["APART"], "interactionType": "SURPRISE", "durationMin": 2, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "mood_intense"], "excludedByBoundaries": ["explore_surprise", "mood_charged"], "chapterKinds": ["WILDCARD", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_new_thing", "version": 1, "title": "Something New", "subtitle": "Neither of you has tried it.", "body": "Surprise them with something neither of you has tried before, planned inside the limits you both know. Ask once more before you begin.", "pack": "SURPRISE", "category": "exploration", "tags": ["novelty", "surprise", "checkIn"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 30, "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "explore_something_new"], "excludedByBoundaries": ["explore_surprise", "explore_novelty"], "chapterKinds": ["WILDCARD", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_choice_bold", "version": 1, "title": "Two Envelopes", "subtitle": "One sweet, one bold.", "body": "Offer two envelopes: one sweet, one bold. They choose without opening either. Open both at the end of the night, together.", "pack": "SURPRISE", "category": "exploration", "tags": ["choice", "surprise", "game"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CHOICE", "durationMin": 5, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "teasing_surprise_choices"], "excludedByBoundaries": ["explore_surprise", "teasing_games"], "chapterKinds": ["YOUR_CHOICE", "WILDCARD"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_one_minute_call", "version": 1, "title": "The One-Minute Call", "subtitle": "Then hang up.", "body": "Call them at an unexpected moment today and, in under a minute, tell them one bold thing you have planned for the next time you are alone. Then hang up.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "voice", "anticipation"], "intensity": 4, "modes": ["APART"], "interactionType": "SURPRISE", "durationMin": 2, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "teasing_delayed_reveal"], "excludedByBoundaries": ["explore_surprise", "teasing_anticipation"], "chapterKinds": ["WILDCARD", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_whole_night", "version": 1, "title": "The Whole Night, Planned", "subtitle": "Every step a surprise.", "body": "Plan your next bold night from start to finish, within the limits you agreed, and tell them nothing. Tonight, give them a sealed envelope with only the first step inside.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "planning", "trust"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 15, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "power_direct_the_evening", "explore_trust"], "excludedByBoundaries": ["explore_surprise", "power_leading", "explore_trust"], "chapterKinds": ["FINALE", "CONTROL"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_blindfold_arrival", "version": 1, "title": "Arrival, Blindfolded", "subtitle": "The reveal is the room.", "body": "Blindfold them at the door and lead them into a room you have prepared. Take the blindfold off only when everything is exactly right.", "pack": "SURPRISE", "category": "exploration", "tags": ["blindfold", "surprise", "trust"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 15, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "sensory_blindfold"], "excludedByBoundaries": ["explore_surprise", "sensory_blindfold"], "chapterKinds": ["FINALE", "TEASE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_bold_message_timed", "version": 1, "title": "The Midnight Surprise", "subtitle": "Scheduled for twelve.", "body": "Schedule the boldest message you have ever sent them to arrive at exactly midnight. Do not mention it beforehand.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "message", "bedtime"], "intensity": 5, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 3, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "mood_intense"], "excludedByBoundaries": ["explore_surprise", "mood_charged"], "chapterKinds": ["FINALE", "WILDCARD"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_role", "version": 1, "title": "Someone New at the Door", "subtitle": "They answer, you're in role.", "body": "Knock on your own front door in character, as someone they have never met. Stay in role for as long as they want to play.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "roleplay", "strangers"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 20, "moods": ["bold", "roleplay"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "roleplay_strangers"], "excludedByBoundaries": ["explore_surprise", "roleplay_strangers", "roleplay_characters"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_dare_jar", "version": 1, "title": "The Bold Jar", "subtitle": "One a night.", "body": "Fill a jar with bold dares for each other, inside your limits. Draw one at a random moment tonight and do it immediately.", "pack": "SURPRISE", "category": "exploration", "tags": ["dare", "surprise", "game"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CHALLENGE", "durationMin": 10, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "teasing_playful_challenges"], "excludedByBoundaries": ["explore_surprise", "teasing_games"], "chapterKinds": ["CHALLENGE", "WILDCARD"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_instruction", "version": 1, "title": "The Surprise Instruction", "subtitle": "Arrives mid-evening.", "body": "Partway through the evening, hand them a sealed note with one bold instruction. They follow it, or say pass, no explanation needed.", "pack": "SURPRISE", "category": "exploration", "tags": ["instructions", "surprise", "secrets"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 5, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "teasing_secret_instructions"], "excludedByBoundaries": ["explore_surprise", "teasing_instructions"], "chapterKinds": ["CONTROL", "WILDCARD"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "surprise_apart_package", "version": 1, "title": "A Package for Tonight", "subtitle": "Opened on a call.", "body": "Post them a small package to open on a video call with you: something to wear, something to hold, and a note for afterwards.", "pack": "SURPRISE", "category": "exploration", "tags": ["gift", "surprise", "distance"], "intensity": 5, "modes": ["APART"], "interactionType": "SURPRISE", "durationMin": 20, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "mood_intense"], "excludedByBoundaries": ["explore_surprise", "mood_charged"], "chapterKinds": ["FINALE", "WILDCARD"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
