    {"id": "surprise_date_night", "version": 1, "title": "Stolen Away", "subtitle": "Everything is arranged.", "body": "Tell them you are stealing them away for an evening soon and that everything will be arranged. Tonight, they only have to pick the date and say yes.", "pack": "SURPRISE", "category": "exploration", "tags": ["surprise", "date", "adventure"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "SURPRISE", "durationMin": 5, "moods": ["romantic", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["explore_being_surprised", "explore_adventure"], "excludedByBoundaries": ["explore_surprise", "explore_novelty"], "chapterKinds": ["WILDCARD", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
