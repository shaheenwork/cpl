{
  "pack": "POWER_DYNAMICS",
  "items": [
    {"id": "power_decider", "version": 1, "title": "The Decider", "subtitle": "One of you chooses everything.", "body": "For the rest of the evening, one of you makes every small decision: what to eat, what to watch, where to sit. The other simply enjoys it.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "lead", "choice"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 20, "moods": ["romantic", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_direct_the_evening", "power_partner_decides"], "excludedByBoundaries": ["power_leading", "power_yielding"], "chapterKinds": ["CONTROL", "YOUR_CHOICE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_you_pick_i_follow", "version": 1, "title": "You Pick, I Follow", "subtitle": "Three choices in a row.", "body": "Hand them three decisions in a row, the film, the snack, the blanket. Accept every answer without a single complaint.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "follow", "choice"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_partner_decides"], "excludedByBoundaries": ["power_yielding"], "chapterKinds": ["CONTROL", "WARM_UP"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_host_for_the_night", "version": 1, "title": "Host for the Night", "subtitle": "Everything arranged by you.", "body": "Host them at home tonight as if they were your most important guest. You plan it, you set it up, they only arrive.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["lead", "planning", "date"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_direct_the_evening"], "excludedByBoundaries": ["power_leading"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_playlist_rule", "version": 1, "title": "DJ Rules", "subtitle": "The DJ decides.", "body": "Whoever is DJ tonight picks every song, and the other may not skip a single one. Trade roles tomorrow.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["music", "power", "game"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["unpredictable", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "sensory_music"], "excludedByBoundaries": ["power_leading", "sensory_atmosphere"], "chapterKinds": ["CONTROL", "WILDCARD"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_remote_decider", "version": 1, "title": "Choose My Evening", "subtitle": "From wherever you are.", "body": "From a distance, they choose how you spend the next half hour: what you eat, what you watch, what you wear. Send photos as proof.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "choice", "distance"], "intensity": 1, "modes": ["APART"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["unpredictable", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_partner_decides"], "excludedByBoundaries": ["power_yielding"], "chapterKinds": ["CONTROL", "YOUR_CHOICE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_simon_says", "version": 1, "title": "Couple Says", "subtitle": "Only when they say it.", "body": "Play 'Couple Says' for five minutes: do only what they ask when they start with 'Couple says'. Every slip-up costs a kiss.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["game", "follow", "laughter"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 5, "moods": ["unpredictable", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_follow_instructions", "teasing_playful_challenges"], "excludedByBoundaries": ["power_yielding", "teasing_games"], "chapterKinds": ["CONTROL", "WARM_UP"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_lead_the_walk", "version": 1, "title": "Lead the Way", "subtitle": "Eyes on them.", "body": "Take them on a short walk where they do not know the route. They hold your hand and trust every turn.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["trust", "lead", "adventure"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 15, "moods": ["romantic", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "explore_trust"], "excludedByBoundaries": ["power_leading", "explore_trust"], "chapterKinds": ["CONTROL", "WARM_UP"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_pick_for_me", "version": 1, "title": "Order for Me", "subtitle": "At the next meal.", "body": "At your next meal together, they choose everything for you without asking what you want. Enjoy whatever arrives.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["follow", "trust", "taste"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONTROL", "durationMin": 5, "moods": ["romantic", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_partner_decides", "explore_trust"], "excludedByBoundaries": ["power_yielding", "explore_trust"], "chapterKinds": ["CONTROL", "YOUR_CHOICE"], "noveltyWeight": 0.4, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_who_leads_talk", "version": 1, "title": "Who Leads?", "subtitle": "An honest chat.", "body": "Talk about when each of you likes to lead and when you like to be led, in everyday life and otherwise. No wrong answers.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "checkIn", "trust"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 8, "moods": ["talk", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_switch_roles", "explore_trust"], "excludedByBoundaries": ["power_switching", "explore_trust"], "chapterKinds": ["CURIOSITY", "WARM_UP"], "noveltyWeight": 0.4, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_three_yeses", "version": 1, "title": "Three Yeses", "subtitle": "Say yes to the next three.", "body": "Say yes to the next three things they ask of you, each within your limits. They must use their three wisely.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "follow", "trust"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_partner_decides", "power_follow_instructions"], "excludedByBoundaries": ["power_yielding"], "chapterKinds": ["CONTROL", "YOUR_CHOICE"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_dress_me", "version": 1, "title": "Dress Me", "subtitle": "Tonight's outfit is theirs to choose.", "body": "They choose what you wear for the evening, down to the last detail. You wear it with total confidence.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "follow", "costume"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["naughty", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_partner_decides"], "excludedByBoundaries": ["power_yielding"], "chapterKinds": ["CONTROL", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_hand_signals", "version": 1, "title": "Hand Signals", "subtitle": "No words, only gestures.", "body": "For ten minutes, they direct you using only hand signals: come here, sit, closer, stop. You work out each one.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "game", "follow"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "power_follow_instructions"], "excludedByBoundaries": ["power_leading", "power_yielding"], "chapterKinds": ["CONTROL", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_the_request", "version": 1, "title": "The Request Jar", "subtitle": "Draw one, grant it.", "body": "Each write five small requests and fold them into a jar. Take turns drawing one and granting it, no questions asked.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "game", "surprise"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "CHOICE", "durationMin": 15, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_partner_decides", "teasing_surprise_choices"], "excludedByBoundaries": ["power_yielding", "teasing_games"], "chapterKinds": ["YOUR_CHOICE", "WILDCARD"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_lead_the_dance", "version": 1, "title": "Follow My Lead", "subtitle": "One song.", "body": "Dance to one song where one of you leads completely. The follower does not anticipate, only responds.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["dancing", "lead", "follow"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 5, "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "sensory_music"], "excludedByBoundaries": ["power_leading", "sensory_atmosphere"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_remote_rules", "version": 1, "title": "House Rules", "subtitle": "Set from afar.", "body": "Set three playful rules for them to keep until you next speak: something to wear, something to say, something to think about.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "instructions", "distance"], "intensity": 2, "modes": ["APART"], "interactionType": "CONTROL", "durationMin": 5, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "teasing_secret_instructions"], "excludedByBoundaries": ["power_leading", "teasing_instructions"], "chapterKinds": ["CONTROL", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_trade_the_lead", "version": 1, "title": "Trade the Lead", "subtitle": "Every five minutes.", "body": "For half an hour, whoever is leading switches every five minutes. Notice which half you enjoy more, and say so.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["switch", "power", "game"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_switch_roles"], "excludedByBoundaries": ["power_switching"], "chapterKinds": ["CONTROL", "WILDCARD"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_quiz", "version": 1, "title": "Leader or Follower?", "subtitle": "Predict their answers.", "body": "Predict whether they would rather lead or follow in five situations you invent, from dancing to planning a holiday. Check your answers.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["prediction", "power", "game"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "PREDICTION", "durationMin": 8, "moods": ["talk", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_switch_roles"], "excludedByBoundaries": ["power_switching"], "chapterKinds": ["CURIOSITY", "WILDCARD"], "noveltyWeight": 0.5, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_yes_chef", "version": 1, "title": "Yes, Chef", "subtitle": "The kitchen belongs to them.", "body": "Cook something together where one of you is head chef and the other replies to every request with 'yes, chef'. Enjoy the meal.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "follow", "taste"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["unpredictable", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "power_follow_instructions"], "excludedByBoundaries": ["power_leading", "power_yielding"], "chapterKinds": ["CONTROL", "WARM_UP"], "noveltyWeight": 0.5, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_in_charge_tonight", "version": 1, "title": "In Charge Tonight", "subtitle": "Every decision, theirs.", "body": "One of you is in charge of the whole night, within the limits you both set. The other agrees to every reasonable request, gracefully.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "lead", "trust"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "power_give_up_control"], "excludedByBoundaries": ["power_leading", "power_yielding"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_instructions_by_text", "version": 1, "title": "Instructions by Message", "subtitle": "Follow them, one at a time.", "body": "Send them five instructions by message over the evening, one at a time, each only after they confirm the last is done.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["instructions", "power", "message"], "intensity": 3, "modes": ["APART"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_follow_instructions", "teasing_secret_instructions"], "excludedByBoundaries": ["power_yielding", "teasing_instructions"], "chapterKinds": ["CONTROL", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_stay_there", "version": 1, "title": "Stay There", "subtitle": "Don't move until I say.", "body": "Ask them to stay exactly where they are while you move around them, deciding when to come closer. They wait for your word.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "anticipation", "follow"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 5, "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "power_follow_instructions"], "excludedByBoundaries": ["power_leading", "power_yielding"], "chapterKinds": ["CONTROL", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_permission_to_kiss", "version": 1, "title": "Permission Required", "subtitle": "Ask first. Every time.", "body": "For the next fifteen minutes, they must ask your permission before every kiss, and you may say 'not yet' as often as you like.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "kissing", "anticipation"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 15, "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "teasing_anticipation"], "excludedByBoundaries": ["power_leading", "teasing_anticipation"], "chapterKinds": ["CONTROL", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_choose_for_them", "version": 1, "title": "Your Pick, Their Evening", "subtitle": "Menu of three.", "body": "Offer them a menu of three ways the next half hour could go. They choose one. From then on, you lead.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["choice", "lead", "power"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "CHOICE", "durationMin": 30, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "teasing_surprise_choices"], "excludedByBoundaries": ["power_leading", "teasing_games"], "chapterKinds": ["YOUR_CHOICE", "CONTROL"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_hands_behind_back", "version": 1, "title": "Hands Behind Your Back", "subtitle": "Unless told otherwise.", "body": "For ten minutes, one of you keeps their hands behind their back unless the other says otherwise. Enjoy not being in charge, for once.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "anticipation", "trust"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_give_up_control", "teasing_anticipation"], "excludedByBoundaries": ["power_yielding", "teasing_anticipation"], "chapterKinds": ["CONTROL", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_negotiation_chat", "version": 1, "title": "The Negotiation", "subtitle": "Before anything bold.", "body": "Sit down and agree what a night with one of you in charge would look like: what is welcome, what is off limits, and your safe word.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["checkIn", "power", "trust"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["talk", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_negotiated_play", "explore_trust"], "excludedByBoundaries": ["power_negotiated", "explore_trust"], "chapterKinds": ["CURIOSITY", "CONFESSION"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_remote_control_evening", "version": 1, "title": "Their Remote Evening", "subtitle": "They choose from afar.", "body": "Over a video call, they choose what you do for twenty minutes: where you sit, what you say, when you may stop smiling.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "distance", "follow"], "intensity": 3, "modes": ["APART"], "interactionType": "CONTROL", "durationMin": 20, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_partner_decides", "power_follow_instructions"], "excludedByBoundaries": ["power_yielding"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_switch_mid_kiss", "version": 1, "title": "Switch", "subtitle": "Mid-kiss, the lead changes.", "body": "Kiss with one of you completely leading. When they squeeze your hand, you take over. Keep switching until neither of you remembers who started.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["switch", "kissing", "power"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 5, "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_switch_roles"], "excludedByBoundaries": ["power_switching"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_rules_of_the_night", "version": 1, "title": "Rules of the Night", "subtitle": "Written, agreed, kept.", "body": "The one in charge writes three rules for the night; the other reads and agrees to them, or amends one. Then the rules stand.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "instructions", "checkIn"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_negotiated_play", "power_follow_instructions"], "excludedByBoundaries": ["power_negotiated", "power_yielding"], "chapterKinds": ["CONTROL", "WARM_UP"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_ask_nicely", "version": 1, "title": "Ask Nicely", "subtitle": "Every request, properly.", "body": "For the rest of the night, one of you must ask for everything properly, in a full sentence, and wait for permission.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "verbal", "follow"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 20, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_give_up_control", "power_take_the_lead"], "excludedByBoundaries": ["power_yielding", "power_leading"], "chapterKinds": ["CONTROL", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_hold_still", "version": 1, "title": "Hold Still", "subtitle": "However tempting.", "body": "They hold perfectly still while you take your time. Every movement they make resets your count to zero.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "slowBurn", "anticipation"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_give_up_control", "teasing_anticipation"], "excludedByBoundaries": ["power_yielding", "teasing_anticipation"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_the_leash_of_words", "version": 1, "title": "A Voice to Follow", "subtitle": "Their voice, nothing else.", "body": "One of you closes their eyes and follows only the other's voice for ten minutes: where to move, how slowly, when to stop.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "trust", "instructions"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_follow_instructions", "explore_trust"], "excludedByBoundaries": ["power_yielding", "explore_trust"], "chapterKinds": ["CONTROL", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_control_by_message", "version": 1, "title": "In Your Pocket", "subtitle": "Their messages, your evening.", "body": "For one evening apart, every choice you make waits for their message first. They decide, you report back, they decide again.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "distance", "follow"], "intensity": 4, "modes": ["APART"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_partner_decides", "power_give_up_control"], "excludedByBoundaries": ["power_yielding"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_reward_system", "version": 1, "title": "Earned It", "subtitle": "Everything must be earned.", "body": "Tonight, every kiss must be earned. The one in charge sets the tasks; the other decides how hard they want to try.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "game", "kissing"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 20, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_take_the_lead", "teasing_playful_challenges"], "excludedByBoundaries": ["power_leading", "teasing_games"], "chapterKinds": ["CONTROL", "CHALLENGE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_check_in", "version": 1, "title": "Green, Yellow, Red", "subtitle": "Say it any time.", "body": "Before a bold night, agree to use green, yellow and red as check-ins. Use them at least once, just to know they work.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["checkIn", "trust", "power"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONVERSATION", "durationMin": 3, "moods": ["talk", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_negotiated_play", "explore_trust"], "excludedByBoundaries": ["power_negotiated", "explore_trust"], "chapterKinds": ["WARM_UP", "CONFESSION"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_tell_me_to", "version": 1, "title": "Tell Me To", "subtitle": "They choose the words.", "body": "Ask them to tell you exactly what they want you to do next. Do it, precisely as said, and nothing more until they say so.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "follow", "verbal"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_follow_instructions", "power_partner_decides"], "excludedByBoundaries": ["power_yielding"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_sealed_rules", "version": 1, "title": "The Sealed Rule", "subtitle": "Opened at a moment they choose.", "body": "Write one rule for them in a sealed note. They must open it the moment you give the signal, and keep it for the rest of the night.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["instructions", "secrets", "power"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 5, "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["teasing_secret_instructions", "power_follow_instructions"], "excludedByBoundaries": ["teasing_instructions", "power_yielding"], "chapterKinds": ["CONTROL", "WILDCARD"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_full_surrender", "version": 1, "title": "Hand Over the Night", "subtitle": "Within the limits, all of it.", "body": "Hand over the whole night. Within the limits you agreed and with your safe word ready, they decide everything that happens.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "trust", "follow"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["bold", "naughty"], "requiredMutualPreferences": ["power_negotiated_play"], "boostedByPreferences": ["power_give_up_control", "power_negotiated_play"], "excludedByBoundaries": ["power_yielding", "power_negotiated"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_commands_only", "version": 1, "title": "Commands Only", "subtitle": "Short. Clear. Kind.", "body": "For twenty minutes, the one in charge speaks only in short, clear commands. The other answers only 'yes' or the safe word.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "instructions", "trust"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 20, "moods": ["bold", "naughty"], "requiredMutualPreferences": ["power_negotiated_play"], "boostedByPreferences": ["power_negotiated_play", "power_follow_instructions"], "excludedByBoundaries": ["power_negotiated", "power_yielding"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_waiting_game", "version": 1, "title": "The Waiting Game", "subtitle": "They decide when.", "body": "Nothing happens until they decide it does. You may ask once. After that, you wait, however long they make you.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "anticipation", "slowBurn"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 15, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_give_up_control", "teasing_anticipation"], "excludedByBoundaries": ["power_yielding", "teasing_anticipation"], "chapterKinds": ["CONTROL", "TEASE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_scene_apart", "version": 1, "title": "Their Voice, Your Night", "subtitle": "Over a call, all evening.", "body": "On a call, they guide your whole evening alone: what to put on, where to be, what to imagine. Stop the moment either of you says so.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "voice", "distance"], "intensity": 5, "modes": ["APART"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_follow_instructions", "comm_voice"], "excludedByBoundaries": ["power_yielding", "comm_voice", "power_negotiated"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_switch_night", "version": 1, "title": "Switch Night", "subtitle": "Half each.", "body": "Split the night in two. One of you leads the first half completely; at midnight, everything reverses. Compare notes in the morning.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["switch", "power", "trust"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 30, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_switch_roles", "power_negotiated_play"], "excludedByBoundaries": ["power_switching", "power_negotiated"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_obey_the_list", "version": 1, "title": "The Agreed List", "subtitle": "Written before, kept after.", "body": "Write a list together of things the one in charge may ask for tonight, and things that are off limits. Follow the list, nothing beyond it.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "checkIn", "instructions"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 20, "moods": ["bold", "talk"], "requiredMutualPreferences": ["power_negotiated_play"], "boostedByPreferences": ["power_negotiated_play", "power_follow_instructions"], "excludedByBoundaries": ["power_negotiated", "power_yielding"], "chapterKinds": ["CONTROL", "CONFESSION"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_aftercare", "version": 1, "title": "Afterwards", "subtitle": "Come back gently.", "body": "After any night where one of you was in charge, spend ten minutes close together. Say what felt good, and one thing to change.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["aftercare", "checkIn", "trust"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_negotiated_play", "explore_trust"], "excludedByBoundaries": ["power_negotiated", "explore_trust"], "chapterKinds": ["FINALE", "CONFESSION"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_their_rules_all_week", "version": 1, "title": "All Week", "subtitle": "Small rules, every day.", "body": "For one week, they set you one small, playful rule each morning by message. Keep every one, and report back each night.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["power", "instructions", "distance"], "intensity": 5, "modes": ["APART"], "interactionType": "CONTROL", "durationMin": 5, "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["power_follow_instructions", "teasing_secret_instructions"], "excludedByBoundaries": ["power_yielding", "teasing_instructions"], "chapterKinds": ["CONTROL", "WILDCARD"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "power_blindfold_trust", "version": 1, "title": "Blindfolded Trust", "subtitle": "They lead. You feel.", "body": "Blindfolded, you let them lead you through ten slow minutes of touch they choose, within the limits you agreed. Say the safe word any time.", "pack": "POWER_DYNAMICS", "category": "power", "tags": ["blindfold", "trust", "power"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["bold", "mysterious"], "requiredMutualPreferences": ["sensory_blindfold"], "boostedByPreferences": ["sensory_blindfold", "power_give_up_control"], "excludedByBoundaries": ["sensory_blindfold", "power_yielding", "power_negotiated"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"}
  ]
}
