{
  "pack": "ROLEPLAY",
  "items": [
    {"id": "roleplay_detectives", "version": 1, "title": "The Case of Us", "subtitle": "Two detectives, one mystery.", "body": "Play two detectives investigating a mystery: who took the last biscuit, who chose this film. Interrogate each other with total seriousness.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "laughter", "game"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "ROLEPLAY", "durationMin": 8, "moods": ["roleplay", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["WARM_UP", "ROLEPLAY"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_talk_show", "version": 1, "title": "The Late Show", "subtitle": "They are the guest.", "body": "One of you hosts a late-night talk show, the other is tonight's famous guest. Ask about their scandalous rise to fame.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "laughter", "storytelling"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "ROLEPLAY", "durationMin": 8, "moods": ["roleplay", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["WARM_UP", "ROLEPLAY"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_critic_dinner", "version": 1, "title": "The Critic", "subtitle": "Every dish, reviewed.", "body": "During your next meal together, one of you is a famous food critic, the other a nervous chef. Stay in role until dessert.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "laughter", "taste"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 20, "moods": ["roleplay", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["WARM_UP", "WILDCARD"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_time_travellers", "version": 1, "title": "Time Travellers", "subtitle": "Just arrived. Very confused.", "body": "You have both just arrived from different centuries and are meeting for the first time. Explain modern life to each other, badly.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "laughter", "fantasy"], "intensity": 1, "modes": ["TOGETHER", "APART"], "interactionType": "ROLEPLAY", "durationMin": 8, "moods": ["roleplay", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "roleplay_fantasy"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "WILDCARD"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_royal_evening", "version": 1, "title": "Royalty for an Evening", "subtitle": "Titles required.", "body": "For the rest of the evening, address each other only by grand, invented royal titles. Every request must be made formally.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "laughter", "characters"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 15, "moods": ["roleplay", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "WILDCARD"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_spy_password", "version": 1, "title": "The Password", "subtitle": "Spies meet at midnight.", "body": "Agree on a spy password and countersign. Tonight, neither of you gets a kiss until the other says the password correctly, in a whisper.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "whisper", "game"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 3, "moods": ["roleplay", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "roleplay_adventure"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "TEASE"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_pen_pals", "version": 1, "title": "Pen Pals", "subtitle": "Letters from far away.", "body": "Write each other a letter as pen pals who have never met, describing your lives in another country. Send it by message.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "letter", "storytelling"], "intensity": 1, "modes": ["APART"], "interactionType": "ROLEPLAY", "durationMin": 10, "moods": ["roleplay", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "comm_storytelling"], "excludedByBoundaries": ["roleplay_characters", "comm_fantasies"], "chapterKinds": ["ROLEPLAY", "WARM_UP"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_trailer_voice", "version": 1, "title": "In a World...", "subtitle": "Narrate your night.", "body": "Narrate your evening together in the voice of a dramatic film trailer. The other acts out every scene you announce.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "laughter", "storytelling"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 5, "moods": ["roleplay", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["WILDCARD", "ROLEPLAY"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_tour_guide", "version": 1, "title": "The Tour", "subtitle": "Your home, very grand.", "body": "Give them a guided tour of your own home as if it were a stately mansion open for one night only. Charge a kiss for entry.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "laughter"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 8, "moods": ["roleplay", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "mood_playful"], "excludedByBoundaries": ["roleplay_characters", "mood_gentle"], "chapterKinds": ["WARM_UP", "ROLEPLAY"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_fortune_teller", "version": 1, "title": "The Fortune Teller", "subtitle": "Your future, suspiciously specific.", "body": "One of you is a fortune teller reading the other's palm. The predictions must all involve the two of you, and must get cheekier.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "touch", "future"], "intensity": 1, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 5, "moods": ["roleplay", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "TEASE"], "noveltyWeight": 0.4, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_mystery_date_plan", "version": 1, "title": "The Mystery Date", "subtitle": "One plans. One wonders.", "body": "One of you plans the next date without telling the other anything but the time to be ready and what to wear.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["mysteryDate", "surprise", "planning"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "SURPRISE", "durationMin": 5, "moods": ["roleplay", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_mystery_date"], "excludedByBoundaries": ["roleplay_mystery_date"], "chapterKinds": ["WILDCARD", "YOUR_CHOICE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_masquerade", "version": 1, "title": "The Masquerade", "subtitle": "Masks on. Names off.", "body": "Wear anything that covers your eyes and pretend you are meeting at a masquerade. Flirt without using real names until midnight.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "costume", "flirting"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 15, "moods": ["roleplay", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_costume"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_dance_lesson", "version": 1, "title": "The Dance Lesson", "subtitle": "Strict teacher. Keen student.", "body": "One of you is a dance instructor, the other a student with a crush. The lesson requires a lot of correcting of posture.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "dancing", "touch"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 10, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "sensory_music"], "excludedByBoundaries": ["roleplay_characters", "sensory_atmosphere"], "chapterKinds": ["ROLEPLAY", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_the_interview", "version": 1, "title": "The Interview", "subtitle": "For the position of your date.", "body": "Interview them for the position of your date tonight. Ask about relevant experience, strengths, and how they handle pressure.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "laughter", "flirting"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "ROLEPLAY", "durationMin": 8, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "WARM_UP"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_barista_regular", "version": 1, "title": "The Regular", "subtitle": "Same coffee every day.", "body": "One of you is the barista who has been quietly flirting with the other, a regular, for months. Today one of you finally says something.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "flirting", "characters"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "ROLEPLAY", "durationMin": 8, "moods": ["roleplay", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "CURIOSITY"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_star_and_fan", "version": 1, "title": "The Star and the Fan", "subtitle": "An exclusive interview.", "body": "One of you is a famous star, the other a devoted fan who has won a private meeting. The star is more nervous than expected.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "flirting", "laughter"], "intensity": 2, "modes": ["TOGETHER", "APART"], "interactionType": "ROLEPLAY", "durationMin": 8, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "WILDCARD"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_wrong_number", "version": 1, "title": "Wrong Number", "subtitle": "Texting someone you've never met.", "body": "Send a message as if you have texted the wrong number by accident. Keep the conversation going as two people who should not be flirting, but are.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "message", "flirting"], "intensity": 2, "modes": ["APART"], "interactionType": "ROLEPLAY", "durationMin": 15, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "comm_flirty_conversation"], "excludedByBoundaries": ["roleplay_characters", "comm_flirting"], "chapterKinds": ["ROLEPLAY", "TEASE"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_hotel_concierge", "version": 1, "title": "The Concierge", "subtitle": "Anything you desire, madam, sir.", "body": "One of you is the concierge of a very exclusive hotel. The other is a demanding guest. Every request must be granted with a flourish.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "laughter", "power"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 10, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "power_partner_decides"], "excludedByBoundaries": ["roleplay_characters", "power_yielding"], "chapterKinds": ["ROLEPLAY", "CONTROL"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_character_draw", "version": 1, "title": "Draw a Character", "subtitle": "Two folded papers.", "body": "Each write a character on a folded paper, a pirate, a poet, a duchess. Trade papers and play them for ten minutes.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "characters", "surprise"], "intensity": 2, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 12, "moods": ["roleplay", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "WILDCARD"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_hotel_lobby", "version": 1, "title": "Hotel Lobby", "subtitle": "Two people who've never met.", "body": "Meet as two strangers in a hotel lobby. Invent your names and your reasons for being there. One of you makes the first move.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "strangers", "flirting"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 20, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_strangers"], "excludedByBoundaries": ["roleplay_strangers"], "chapterKinds": ["ROLEPLAY", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_secret_agent", "version": 1, "title": "The Secret Agent", "subtitle": "Mission: seduce the target.", "body": "One of you is a secret agent whose mission is to win the other's trust by any charming means necessary. The target is suspicious.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "flirting", "adventure"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 15, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "roleplay_adventure"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_enemies_to_lovers", "version": 1, "title": "Rivals", "subtitle": "You can't stand each other. Allegedly.", "body": "Play two fierce rivals stuck sharing a room for the night. Every argument gets a little closer to not being an argument at all.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "characters", "slowBurn"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 15, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_photographer", "version": 1, "title": "The Shoot", "subtitle": "Hold that pose.", "body": "One of you is a photographer, the other the model. The photographer directs every pose, and keeps finding reasons to adjust things by hand.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "touch", "power"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 15, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "power_take_the_lead"], "excludedByBoundaries": ["roleplay_characters", "power_leading"], "chapterKinds": ["ROLEPLAY", "CONTROL"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_costume_night", "version": 1, "title": "Dress the Part", "subtitle": "Characters, with outfits.", "body": "Each choose a character and put together a costume from whatever you have at home. Stay in character for the whole evening.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "costume", "characters"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 30, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_costume"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_love_letters_century", "version": 1, "title": "Letters From 1890", "subtitle": "Forbidden correspondence.", "body": "Write each other letters as secret lovers in 1890 whose families disapprove. Send one a day by message, sealed with something bold.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "letter", "fantasy"], "intensity": 3, "modes": ["APART"], "interactionType": "ROLEPLAY", "durationMin": 10, "moods": ["roleplay", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "roleplay_fantasy"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_the_proposition", "version": 1, "title": "The Proposition", "subtitle": "Business, allegedly.", "body": "One of you arrives with a very serious business proposition. The other keeps steering the meeting somewhere far less professional.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "flirting", "laughter"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "ROLEPLAY", "durationMin": 10, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "mood_naughty"], "excludedByBoundaries": ["roleplay_characters", "mood_charged"], "chapterKinds": ["ROLEPLAY", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_the_new_neighbour", "version": 1, "title": "The New Neighbour", "subtitle": "Borrowing something. Again.", "body": "One of you has just moved in next door and keeps finding reasons to knock. The other starts leaving the door open.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "flirting", "characters"], "intensity": 3, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 15, "moods": ["roleplay", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters"], "excludedByBoundaries": ["roleplay_characters"], "chapterKinds": ["ROLEPLAY", "TEASE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_by_voice", "version": 1, "title": "Stay in Role", "subtitle": "A voice call in character.", "body": "Call each other and stay in role the whole time: two people who met once on holiday and have not stopped thinking about it.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "voice", "memories"], "intensity": 3, "modes": ["APART"], "interactionType": "ROLEPLAY", "durationMin": 15, "moods": ["roleplay", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "comm_voice"], "excludedByBoundaries": ["roleplay_characters", "comm_voice"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.6, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_choose_the_scene", "version": 1, "title": "Choose the Scene", "subtitle": "Three settings, one pick.", "body": "Offer three roleplay settings: a train at night, a castle, a heatwave in the city. They choose one and set the first line.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "choice", "fantasy"], "intensity": 3, "modes": ["TOGETHER", "APART"], "interactionType": "CHOICE", "durationMin": 5, "moods": ["roleplay", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "teasing_surprise_choices"], "excludedByBoundaries": ["roleplay_characters", "teasing_games"], "chapterKinds": ["YOUR_CHOICE", "ROLEPLAY"], "noveltyWeight": 0.6, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_strangers_night", "version": 1, "title": "Strangers for a Night", "subtitle": "Arrive separately.", "body": "Arrive somewhere separately, a restaurant or a lobby, and meet as strangers. Stay strangers all the way home, and past the door.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "strangers", "anticipation"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 30, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_strangers"], "excludedByBoundaries": ["roleplay_strangers"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_royal_and_guard", "version": 1, "title": "The Royal and the Guard", "subtitle": "Duty versus desire.", "body": "One of you is a royal, the other the bodyguard sworn to keep a respectful distance. Tonight the rules are tested, carefully.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "power", "slowBurn"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 20, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "roleplay_power_scenario"], "excludedByBoundaries": ["roleplay_characters", "roleplay_power"], "chapterKinds": ["ROLEPLAY", "CONTROL"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_safe_word", "version": 1, "title": "Before You Begin", "subtitle": "Agree the word.", "body": "Before any bold roleplay, agree a safe word, the limits, and one thing each of you is looking forward to. Then begin.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["checkIn", "roleplay", "trust"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONVERSATION", "durationMin": 5, "moods": ["roleplay", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_power_scenario", "explore_trust"], "excludedByBoundaries": ["roleplay_power", "explore_trust"], "chapterKinds": ["WARM_UP", "CURIOSITY"], "noveltyWeight": 0.7, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_the_boss_evening", "version": 1, "title": "The Boss for an Evening", "subtitle": "Everything is an order.", "body": "One of you plays the boss for the evening, the other the assistant eager to impress. Within your agreed limits, every request is followed.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "power", "instructions"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 20, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_power_scenario", "power_follow_instructions"], "excludedByBoundaries": ["roleplay_power", "power_yielding"], "chapterKinds": ["ROLEPLAY", "CONTROL"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_stranger_texts_bold", "version": 1, "title": "Unknown Number", "subtitle": "Bolder with every message.", "body": "Message each other as two strangers who met briefly and can't stop thinking about it. Each message a little bolder than the one before.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "strangers", "message"], "intensity": 4, "modes": ["APART"], "interactionType": "ROLEPLAY", "durationMin": 15, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_strangers"], "excludedByBoundaries": ["roleplay_strangers"], "chapterKinds": ["ROLEPLAY", "TEASE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_the_artist", "version": 1, "title": "The Artist's Model", "subtitle": "Sit very still.", "body": "One of you is an artist sketching the other, who must sit perfectly still while being studied very closely. The artist takes their time.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "eyeContact", "slowBurn"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 20, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "power_take_the_lead"], "excludedByBoundaries": ["roleplay_characters", "power_leading"], "chapterKinds": ["ROLEPLAY", "CONTROL"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_forbidden_meeting", "version": 1, "title": "The Forbidden Meeting", "subtitle": "Nobody can know.", "body": "Play two people meeting in secret on borrowed time. Keep your voices low; the clock is not on your side.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "secrets", "anticipation"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 20, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "mood_intense"], "excludedByBoundaries": ["roleplay_characters", "mood_charged"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_director_choice", "version": 1, "title": "You Write Their Lines", "subtitle": "They say them.", "body": "Write three lines for them to say in character. They must deliver each one, exactly as written, at a moment of your choosing.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "power", "instructions"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "power_direct_the_evening"], "excludedByBoundaries": ["roleplay_characters", "power_leading"], "chapterKinds": ["CONTROL", "ROLEPLAY"], "noveltyWeight": 0.7, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_rewrite_first_night", "version": 1, "title": "Rewrite the First Night", "subtitle": "As different people.", "body": "Replay the first night you spent together as two completely different characters. Keep what worked. Change what you wish you had dared.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "memories", "desire"], "intensity": 4, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 20, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "mood_intense"], "excludedByBoundaries": ["roleplay_characters", "mood_charged"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.7, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_power_scene_scripted", "version": 1, "title": "The Scripted Scene", "subtitle": "Agreed in advance, every beat.", "body": "Script a power-dynamic scene together: who leads, what happens, where it stops, and the safe word. Perform it exactly as agreed.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "power", "checkIn"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 30, "moods": ["roleplay", "bold"], "requiredMutualPreferences": ["roleplay_power_scenario"], "boostedByPreferences": ["roleplay_power_scenario"], "excludedByBoundaries": ["roleplay_power"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_strangers_all_night", "version": 1, "title": "Strangers All Night", "subtitle": "Never break it.", "body": "Meet as strangers and never break character, not once, until the next morning. Either of you can step out with the safe word.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "strangers", "trust"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 30, "moods": ["roleplay", "bold"], "requiredMutualPreferences": ["roleplay_strangers"], "boostedByPreferences": ["roleplay_strangers", "power_negotiated_play"], "excludedByBoundaries": ["roleplay_strangers", "power_negotiated"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_hear_it_first", "version": 1, "title": "Hear It First", "subtitle": "Then decide together.", "body": "In character, one of you tells the other exactly what is going to happen tonight. The listener may not interrupt, and can stop everything with the safe word.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "power", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 10, "moods": ["roleplay", "bold"], "requiredMutualPreferences": ["roleplay_power_scenario"], "boostedByPreferences": ["roleplay_power_scenario", "power_give_up_control"], "excludedByBoundaries": ["roleplay_power", "power_yielding", "roleplay_characters"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_fantasy_live", "version": 1, "title": "The Fantasy, Live", "subtitle": "The one you both chose.", "body": "Pick a fantasy you both said yes to and play it out as a scene, with names, a setting and an agreed ending. Stop any time either of you wants.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "fantasy", "checkIn"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 30, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "comm_fantasies"], "excludedByBoundaries": ["roleplay_characters", "comm_fantasies"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_bold_messages", "version": 1, "title": "The Secret Romance", "subtitle": "Kept in messages.", "body": "Message each other all day as two people conducting a thrilling secret romance. By evening, the messages have made a plan.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "message", "anticipation"], "intensity": 5, "modes": ["APART"], "interactionType": "ROLEPLAY", "durationMin": 20, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "mood_intense"], "excludedByBoundaries": ["roleplay_characters", "mood_charged"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_reversal", "version": 1, "title": "The Reversal", "subtitle": "Halfway through, switch.", "body": "Start a power-dynamic scene with one of you leading. Halfway through, at a signal, the roles reverse completely.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "switch", "power"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "ROLEPLAY", "durationMin": 20, "moods": ["roleplay", "bold"], "requiredMutualPreferences": ["roleplay_power_scenario"], "boostedByPreferences": ["roleplay_power_scenario", "power_switch_roles"], "excludedByBoundaries": ["roleplay_power", "power_switching"], "chapterKinds": ["ROLEPLAY", "CONTROL"], "noveltyWeight": 0.8, "repeatCooldownDays": 30, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_voice_bold", "version": 1, "title": "Their Character, Your Voice", "subtitle": "Recorded in role.", "body": "Record a voice message in character: the stranger who cannot forget them, telling them what happens when you finally meet again.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["roleplay", "voice", "strangers"], "intensity": 5, "modes": ["APART"], "interactionType": "MESSAGE", "durationMin": 5, "moods": ["roleplay", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_strangers", "comm_voice"], "excludedByBoundaries": ["roleplay_strangers", "comm_voice", "roleplay_characters"], "chapterKinds": ["ROLEPLAY", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": "VOICE", "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_decide_everything", "version": 1, "title": "You Decide Everything", "subtitle": "For one scene.", "body": "For one scene, one of you decides everything, within the limits you agreed: where, what, how slowly. The other says only yes or the safe word.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["power", "trust", "roleplay"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONTROL", "durationMin": 20, "moods": ["roleplay", "bold"], "requiredMutualPreferences": ["roleplay_power_scenario"], "boostedByPreferences": ["roleplay_power_scenario", "power_give_up_control"], "excludedByBoundaries": ["roleplay_power", "power_yielding", "power_negotiated"], "chapterKinds": ["CONTROL", "FINALE"], "noveltyWeight": 0.8, "repeatCooldownDays": 21, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"},
    {"id": "roleplay_check_in_after", "version": 1, "title": "After the Scene", "subtitle": "Come back to yourselves.", "body": "After any bold roleplay, drop the characters completely. Say what you loved, what you would change, and one thing you want to keep.", "pack": "ROLEPLAY", "category": "roleplay", "tags": ["aftercare", "checkIn", "roleplay"], "intensity": 5, "modes": ["TOGETHER"], "interactionType": "CONVERSATION", "durationMin": 10, "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": ["roleplay_characters", "explore_trust"], "excludedByBoundaries": ["roleplay_characters", "explore_trust"], "chapterKinds": ["FINALE", "CONFESSION"], "noveltyWeight": 0.8, "repeatCooldownDays": 14, "requiresMedia": null, "status": "published", "locale": "en", "createdAt": "2026-09-18T00:00:00.000Z", "updatedAt": "2026-09-18T00:00:00.000Z"}
  ]
