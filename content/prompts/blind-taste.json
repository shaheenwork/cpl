    {"id": "blind_guess_the_pace", "version": 1, "game": "BLIND_TASTE", "kind": null, "text": "Blindfolded, change the pace four times without warning. They say which change they felt first.", "options": [], "seconds": 120, "category": "teasing", "tags": ["game", "blindfold", "slowBurn"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "blind_what_you_used", "version": 1, "game": "BLIND_TASTE", "kind": null, "text": "Blindfolded, and one of the things you use is not part of you. They work out which.", "options": [], "seconds": 120, "category": "sensory", "tags": ["game", "blindfold", "texture"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "blind_where_you_were_going", "version": 1, "game": "BLIND_TASTE", "kind": null, "text": "Blindfolded, stop just short of wherever they think you are heading. They say where that was.", "options": [], "seconds": 120, "category": "teasing", "tags": ["game", "blindfold", "anticipation"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "blind_their_own_words", "version": 1, "game": "BLIND_TASTE", "kind": null, "text": "Blindfolded, do something they asked for once. They have to remember when they asked.", "options": [], "seconds": 120, "category": "communication", "tags": ["game", "blindfold", "desire"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "blind_whole_thing_blind", "version": 1, "game": "BLIND_TASTE", "kind": null, "text": "Blindfolded for the whole three minutes with nothing explained. Then they tell you what they thought was happening.", "options": [], "seconds": 180, "category": "sensory", "tags": ["game", "blindfold", "trust"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "blind_both_blindfolded", "version": 1, "game": "BLIND_TASTE", "kind": null, "text": "Both of you blindfolded, finding each other from opposite sides of the room. Who got there first?", "options": [], "seconds": 150, "category": "sensory", "tags": ["game", "blindfold", "touch"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "blind_they_name_the_want", "version": 1, "game": "BLIND_TASTE", "kind": null, "text": "Blindfolded and taken close to it. Afterwards they name the one thing they wanted you to do.", "options": [], "seconds": 150, "category": "communication", "tags": ["game", "blindfold", "desire"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "blind_stop_when_they_guess", "version": 1, "game": "BLIND_TASTE", "kind": null, "text": "Blindfolded, and it only stops when they correctly name what you are doing.", "options": [], "seconds": 180, "category": "teasing", "tags": ["game", "blindfold", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "blind_two_at_once_which", "version": 1, "game": "BLIND_TASTE", "kind": null, "text": "Blindfolded, two things at once for the whole clock. They name both, afterwards, in detail.", "options": [], "seconds": 150, "category": "sensory", "tags": ["game", "blindfold", "touch"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "blind_they_stay_blind_after", "version": 1, "game": "BLIND_TASTE", "kind": null, "text": "Blindfolded now, and it does not come off when the clock does. They guess what changed.", "options": [], "seconds": 180, "category": "power", "tags": ["game", "blindfold", "power"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "power_negotiated"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"}
