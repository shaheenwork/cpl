    {"id": "three_both_hands_busy", "version": 1, "game": "THREE_MINUTES", "kind": null, "text": "Three minutes doing two things at once, and you already know which two.", "options": [], "seconds": null, "category": "sensory", "tags": ["game", "touch", "whisper"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "three_stop_at_two", "version": 1, "game": "THREE_MINUTES", "kind": null, "text": "Take three minutes, then stop at the two minute mark anyway and make them wait out the rest.", "options": [], "seconds": null, "category": "teasing", "tags": ["game", "anticipation", "slowBurn"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "three_a_rule_each", "version": 1, "game": "THREE_MINUTES", "kind": null, "text": "You each set one rule for the other before it starts. Three minutes inside both of them.", "options": [], "seconds": null, "category": "power", "tags": ["game", "power", "instructions"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "teasing_instructions"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "three_they_choose_everything", "version": 1, "game": "THREE_MINUTES", "kind": null, "text": "They named this three minutes in advance and you agreed to it then. Nothing is decided now.", "options": [], "seconds": null, "category": "power", "tags": ["game", "power", "trust"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_yielding", "power_negotiated"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "three_no_reaction_allowed", "version": 1, "game": "THREE_MINUTES", "kind": null, "text": "Three minutes where they must not move or make a sound. Every failure earns them another minute.", "options": [], "seconds": null, "category": "teasing", "tags": ["game", "dare", "teasing"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["mood_charged", "teasing_games"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "three_then_you_leave", "version": 1, "game": "THREE_MINUTES", "kind": null, "text": "Three minutes, then get up and go and do something else entirely. Come back when you feel like it.", "options": [], "seconds": null, "category": "teasing", "tags": ["game", "anticipation", "slowBurn"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "three_narrate_the_lot", "version": 1, "game": "THREE_MINUTES", "kind": null, "text": "Three minutes where you say everything you are doing and everything you are about to do.", "options": [], "seconds": null, "category": "communication", "tags": ["game", "verbal", "desire"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_words", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "three_they_may_ask_once", "version": 1, "game": "THREE_MINUTES", "kind": null, "text": "Three minutes. They may ask for one thing in that time, and the answer is already yes.", "options": [], "seconds": null, "category": "power", "tags": ["game", "power", "desire"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "three_hardest_first", "version": 1, "game": "THREE_MINUTES", "kind": null, "text": "Start with the thing you would normally save for the end. Three minutes of exactly that.", "options": [], "seconds": null, "category": "teasing", "tags": ["game", "slowBurn", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"}
  ]
