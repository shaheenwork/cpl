    {"id": "said_what_you_would_never_ask", "version": 1, "game": "SAY_IT_OUT_LOUD", "kind": null, "text": "The thing you would never ask for in person. It is easier said to a phone.", "options": [], "seconds": null, "category": "communication", "tags": ["game", "voice", "secrets"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_voice", "comm_confessions"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "said_all_of_it_tonight", "version": 1, "game": "SAY_IT_OUT_LOUD", "kind": null, "text": "Everything you want tonight, start to finish, leaving nothing out to be polite about.", "options": [], "seconds": null, "category": "communication", "tags": ["game", "voice", "desire"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_voice", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "said_the_real_version", "version": 1, "game": "SAY_IT_OUT_LOUD", "kind": null, "text": "The version you edit down when you say it in person. Say the unedited one.", "options": [], "seconds": null, "category": "communication", "tags": ["game", "voice", "fantasy"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_voice", "comm_fantasies"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "said_talk_them_through_it", "version": 1, "game": "SAY_IT_OUT_LOUD", "kind": null, "text": "Talk them through the next hour as if you had already decided all of it.", "options": [], "seconds": null, "category": "communication", "tags": ["game", "voice", "verbal"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_voice", "teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "said_what_you_would_agree_to", "version": 1, "game": "SAY_IT_OUT_LOUD", "kind": null, "text": "Say out loud what you would agree to tonight if they asked for it properly.", "options": [], "seconds": null, "category": "power", "tags": ["game", "voice", "trust"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_voice", "power_negotiated"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "said_their_name_and_nothing", "version": 1, "game": "SAY_IT_OUT_LOUD", "kind": null, "text": "Their name, the way you say it when it is not a question, and then the reason.", "options": [], "seconds": null, "category": "communication", "tags": ["game", "voice", "whisper"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_voice", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "said_kept_and_played_back", "version": 1, "game": "SAY_IT_OUT_LOUD", "kind": null, "text": "Record it knowing they will play it back to you later, at the worst possible moment.", "options": [], "seconds": null, "category": "communication", "tags": ["game", "voice", "teasing"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_voice", "teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"}
