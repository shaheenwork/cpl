    {"id": "red_feet", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Their feet, properly. They call time.", "options": [], "seconds": 90, "category": "exploration", "tags": ["game", "dare"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
