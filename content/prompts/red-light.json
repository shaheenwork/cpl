    {"id": "red_two_places", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Two places at once. Stop the instant they say.", "options": [], "seconds": 90, "category": "exploration", "tags": ["game", "dare"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_eyes_shut", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Their eyes stay shut. Yours don't. They still control the stop.", "options": [], "seconds": 120, "category": "exploration", "tags": ["game", "dare"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "power_negotiated"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
