{
  "game": "RED_LIGHT",
  "items": [
    {"id": "red_hands_face", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Hands on their face and hair. They say stop whenever they like.", "options": [], "seconds": 45, "category": "exploration", "tags": ["game", "dare"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_shoulders", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Work their shoulders. Stop the second they say so.", "options": [], "seconds": 60, "category": "exploration", "tags": ["game", "dare"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_kiss_slow", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Kiss them slowly. They end it whenever they want.", "options": [], "seconds": 45, "category": "exploration", "tags": ["game", "dare"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_flirting"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_hold_them", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Hold them, and let go the moment they ask.", "options": [], "seconds": 60, "category": "exploration", "tags": ["game", "dare"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_hair", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Your hands in their hair until they say enough.", "options": [], "seconds": 45, "category": "exploration", "tags": ["game", "dare"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_tell_them", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Tell them what you like about them. They stop you when they've had enough.", "options": [], "seconds": 60, "category": "exploration", "tags": ["game", "dare"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_flirting"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_feet", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Their feet, properly. They call time.", "options": [], "seconds": 90, "category": "exploration", "tags": ["game", "dare"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_neck", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Start at their neck and go slowly down. Stop where they say.", "options": [], "seconds": 60, "category": "exploration", "tags": ["game", "dare"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch", "teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_fingertips", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Fingertips only, anywhere they allow, until they say stop.", "options": [], "seconds": 60, "category": "exploration", "tags": ["game", "dare"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_whisper", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Whisper what you'd like to do. They stop you when it's too much.", "options": [], "seconds": 45, "category": "exploration", "tags": ["game", "dare"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_uncover", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Uncover one thing at a time. They say when to stop.", "options": [], "seconds": 90, "category": "exploration", "tags": ["game", "dare"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_closer", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Get closer by degrees. They decide how close.", "options": [], "seconds": 60, "category": "exploration", "tags": ["game", "dare"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_two_places", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Two places at once. Stop the instant they say.", "options": [], "seconds": 90, "category": "exploration", "tags": ["game", "dare"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_eyes_shut", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Their eyes stay shut. Yours don't. They still control the stop.", "options": [], "seconds": 120, "category": "exploration", "tags": ["game", "dare"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold", "power_negotiated"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_slow_torture", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "As slowly as you can bear. They end it whenever.", "options": [], "seconds": 120, "category": "exploration", "tags": ["game", "dare"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_their_rules", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "They set one rule first. Then you start, and they stop you.", "options": [], "seconds": 90, "category": "exploration", "tags": ["game", "dare"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "power_leading"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_no_warning", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "No warning about what you'll do. They still say when to stop.", "options": [], "seconds": 120, "category": "exploration", "tags": ["game", "dare"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["mood_charged", "power_negotiated"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_almost", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Take them close and stop the moment they say the word.", "options": [], "seconds": 150, "category": "exploration", "tags": ["game", "dare"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_until_they_say", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Keep going until they say stop, however long that takes.", "options": [], "seconds": 180, "category": "exploration", "tags": ["game", "dare"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["mood_charged", "power_negotiated"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-27T00:00:00.000Z", "updatedAt": "2026-09-27T00:00:00.000Z"},
    {"id": "red_hands_only", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Hands only, anywhere they have already said yes to. They call it whenever.", "options": [], "seconds": 60, "category": "sensory", "tags": ["game", "touch"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_read_it_out", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Read something to them, close enough to feel it. They stop you when they have had enough.", "options": [], "seconds": 60, "category": "communication", "tags": ["game", "storytelling", "verbal"], "intensity": 1, "modes": ["TOGETHER"], "moods": ["romantic", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["comm_flirting"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_scalp", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Work their scalp and the back of their neck. They decide when it ends, and they will not hurry.", "options": [], "seconds": 90, "category": "sensory", "tags": ["game", "massage", "touch"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["romantic", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_one_finger_only", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "A single finger, and nothing else anywhere. They say when it stops.", "options": [], "seconds": 60, "category": "sensory", "tags": ["game", "touch", "texture"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_tell_them_the_plan", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Describe what you have in mind for later. They cut you off the moment it is too much.", "options": [], "seconds": 60, "category": "communication", "tags": ["game", "verbal", "desire"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_no_hands_at_all", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Everything you can manage without using your hands once. They end it when they like.", "options": [], "seconds": 60, "category": "teasing", "tags": ["game", "teasing", "anticipation"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_their_hands_yours", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Move their hands where you want them and hold them there. They take them back whenever.", "options": [], "seconds": 60, "category": "power", "tags": ["game", "touch", "lead"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "romantic"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_leading", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_count_it_out", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Count out loud and do one more thing on every tenth number. They stop the count when they want.", "options": [], "seconds": 45, "category": "teasing", "tags": ["game", "countdown", "anticipation"], "intensity": 2, "modes": ["TOGETHER"], "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_start_low", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Start at their feet and work up, taking far too long. They decide how far up you get.", "options": [], "seconds": 90, "category": "teasing", "tags": ["game", "slowBurn", "touch"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_in_their_ear", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Everything into their ear and nothing above a whisper. They say when to stop, if they can.", "options": [], "seconds": 60, "category": "communication", "tags": ["game", "whisper", "desire"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_one_thing_off", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Take one thing off them as slowly as you can manage. They stop you at any point they like.", "options": [], "seconds": 90, "category": "teasing", "tags": ["game", "teasing", "slowBurn"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_they_stay_still", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "They may not move, but they may still end it. Test both of those.", "options": [], "seconds": 90, "category": "power", "tags": ["game", "follow", "teasing"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_yielding", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_two_hands_two_places", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Two hands, two places, neither of them predictable. They call it whenever they need to.", "options": [], "seconds": 90, "category": "sensory", "tags": ["game", "touch"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_nothing_but_breath", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Close enough that they feel every breath, and never once touching. They end it.", "options": [], "seconds": 60, "category": "teasing", "tags": ["game", "anticipation", "whisper"], "intensity": 3, "modes": ["TOGETHER"], "moods": ["naughty", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_blindfolded_start", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Blindfold them first. They still hold the stop, and they will need it.", "options": [], "seconds": 120, "category": "sensory", "tags": ["game", "blindfold", "trust"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_their_instruction_first", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "They give you one instruction, then you begin. They can stop you but not change it.", "options": [], "seconds": 120, "category": "power", "tags": ["game", "instructions", "follow"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_instructions", "power_yielding"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_cool_thing", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Bring ice from the kitchen and use it slowly. They say the word the second it is too much.", "options": [], "seconds": 90, "category": "sensory", "tags": ["game", "temperature", "touch"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_temperature", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_stop_start", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Stop entirely every twenty seconds and wait. They can end it, but they cannot make you faster.", "options": [], "seconds": 120, "category": "teasing", "tags": ["game", "anticipation", "slowBurn"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_they_ask_to_continue", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "You stop on your own every so often. It only starts again when they ask you to.", "options": [], "seconds": 120, "category": "power", "tags": ["game", "checkIn", "teasing"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_not_where_they_expect", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Never the place they are waiting for. They end it when they cannot stand that any more.", "options": [], "seconds": 120, "category": "teasing", "tags": ["game", "teasing", "surprise"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "explore_surprise"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_as_far_as_they_let", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Go as far as they will let you, and let the stop be the only thing that ends it.", "options": [], "seconds": 180, "category": "mood", "tags": ["game", "desire", "slowBurn"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["mood_charged", "teasing_anticipation"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_no_warning_at_all", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "They get no idea what is coming next, or for how long. The stop is still theirs.", "options": [], "seconds": 150, "category": "exploration", "tags": ["game", "surprise", "trust"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["explore_surprise", "explore_trust"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_whole_evening_pace", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Set the pace of the rest of the evening in these three minutes. They may only slow you down.", "options": [], "seconds": 180, "category": "teasing", "tags": ["game", "slowBurn", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_their_own_words_back", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Do exactly what they described wanting last time, in their words, until they stop you.", "options": [], "seconds": 120, "category": "communication", "tags": ["game", "verbal", "desire"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_words", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_hands_and_mouth", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "Everything you have, all at once, nothing held in reserve. They end it the moment they need to.", "options": [], "seconds": 150, "category": "sensory", "tags": ["game", "touch", "whisper"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "red_then_stop_dead", "version": 1, "game": "RED_LIGHT", "kind": null, "text": "If they have not stopped you by the end, stop anyway, and leave them exactly there.", "options": [], "seconds": 180, "category": "teasing", "tags": ["game", "anticipation", "slowBurn"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"}
