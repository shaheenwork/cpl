    {"id": "dice_reset_on_a_word", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "If either of you speaks, the clock goes back to the start. However long that takes.", "options": ["You are the one doing", "They are", "Both at once", "Whoever moved last"], "seconds": 90, "category": "power", "tags": ["game", "dare", "teasing"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "unpredictable"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
