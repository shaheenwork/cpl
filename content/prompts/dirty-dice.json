    {"id": "dice_stop_before_it_does", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "Get them close to what they want, then stop before the clock does. Early, not late.", "options": ["Your hands", "Your mouth", "Words only", "Their pick of the three"], "seconds": 120, "category": "teasing", "tags": ["game", "anticipation", "slowBurn"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "dice_eyes_shut_no_clues", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "Their eyes stay shut and you say nothing at all. They can work the rest out themselves.", "options": ["One hand", "Two", "Not your hands", "Something from the room"], "seconds": 90, "category": "sensory", "tags": ["game", "touch", "anticipation"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_touch", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "dice_ask_every_ten", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "Every ten seconds they have to ask you to carry on. Silence means you stop where you are.", "options": ["Out loud", "In a whisper", "In your ear", "By name"], "seconds": 120, "category": "power", "tags": ["game", "checkIn", "teasing"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "teasing_words"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "dice_cool_then_hands", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "Something cool, then your hands, alternating every time the clock hits a quarter.", "options": ["Their throat", "Their spine", "Their wrists", "Their stomach"], "seconds": 90, "category": "sensory", "tags": ["game", "temperature", "touch"], "intensity": 4, "modes": ["TOGETHER"], "moods": ["experimental", "bold"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_temperature", "sensory_touch"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "dice_three_slow_minutes", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "Three minutes at a pace that makes them wait for every single part of it. No shortcuts.", "options": ["Your pace", "Their pace", "Half the speed of last time", "Slower than that"], "seconds": 180, "category": "teasing", "tags": ["game", "slowBurn", "anticipation"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_anticipation", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "dice_move_and_it_resets", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "They may not move a muscle. Every time they do, the clock starts again from the top.", "options": ["You choose what happens", "They chose it earlier", "The card says hands", "The card says mouth"], "seconds": 150, "category": "power", "tags": ["game", "follow", "dare"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_yielding", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "dice_blindfold_whole_clock", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "The blindfold goes on before the clock starts and comes off when it stops. Say nothing in between.", "options": ["You wear it", "They wear it", "Both of you", "Whoever asks a question"], "seconds": 150, "category": "sensory", "tags": ["game", "blindfold", "trust"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "mysterious"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["sensory_blindfold"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "dice_carries_on_after", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "Whatever starts on this clock carries on after it, until one of you says otherwise.", "options": ["You start", "They start", "Both at once", "Whoever is behind"], "seconds": 180, "category": "power", "tags": ["game", "power", "desire"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "naughty"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "dice_their_rule_your_pace", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "They set the rule, you set the pace, and neither of you may change your own.", "options": ["No hands", "No sound", "No stopping", "Nothing goes back on"], "seconds": 150, "category": "power", "tags": ["game", "power", "instructions"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "experimental"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["power_negotiated", "teasing_instructions"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"},
    {"id": "dice_narrate_it", "version": 1, "game": "DIRTY_DICE", "kind": null, "text": "Say exactly what you are doing while you do it, for the whole clock, without once tailing off.", "options": ["In plain words", "In a whisper", "In their ear", "Loud enough to be certain"], "seconds": 120, "category": "communication", "tags": ["game", "verbal", "desire"], "intensity": 5, "modes": ["TOGETHER"], "moods": ["bold", "talk"], "requiredMutualPreferences": [], "boostedByPreferences": [], "excludedByBoundaries": ["teasing_words", "mood_charged"], "noveltyWeight": 0.5, "repeatCooldownDays": 30, "status": "published", "locale": "en", "createdAt": "2026-09-29T00:00:00.000Z", "updatedAt": "2026-09-29T00:00:00.000Z"}
