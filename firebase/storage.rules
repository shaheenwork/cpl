rules_version = '2';

// Afterhours Storage rules (BUILD_PROMPT.md §7.2, §5.8).
//
// No object is ever public and no download URL is minted into a shared document. Access
// is always authenticated and always scoped to the owner or to the couple.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 10 * 1024 * 1024;
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*')
             && request.resource.size < 20 * 1024 * 1024;
    }

    // Membership is decided by the same document Firestore decides it by (§7.2): an ACTIVE
    // couple this user is a member of. A couple that ended takes its media with it.
    function isActiveMember(coupleId) {
      return isSignedIn()
             && firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.status == 'ACTIVE'
             && request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.memberUids;
    }

    // The media document the server wrote for this object: what kind it is, whose it is, and
    // whether it is still there at all. A deleted one denies the object with it (§5.8, row P).
    function media(coupleId, itemId) {
      return firestore.get(/databases/(default)/documents/couples/$(coupleId)/media/$(itemId)).data;
    }

    function mediaExists(coupleId, itemId) {
      return firestore.exists(/databases/(default)/documents/couples/$(coupleId)/media/$(itemId));
    }

    // ---- user-scoped -----------------------------------------------------

    match /users/{uid}/avatar/{file} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid) && isImage();
    }

    // A data export (§14.9): everything this app holds about one person, written by the server
    // and readable by that person alone. A client never writes one — an export a phone could
    // write is a file a phone could put anything in, including someone else's name.
    match /users/{uid}/exports/{file} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Content staged before delivery stays private to its author until the server
    // marks the surprise delivered (§5.7).
    match /users/{uid}/outbox/{itemId}/{file} {
      allow read, write: if isSelf(uid) && (isImage() || isAudio());
    }

    // ---- couple-scoped ---------------------------------------------------
    // Nothing here is public and no download URL is minted into a shared document (§5.8):
    // every read is authenticated, scoped to an ACTIVE couple this user belongs to, and
    // gated on the media document the server keeps beside it.

    // A voice note or a photo one partner sent the other (§13). The server reserves the
    // document first, the author uploads into the path it named, and the server confirms it.
    // So every object has a document beside it, and a burn or an expiry deletes the document —
    // which denies the object with it (§5.8, row P).
    function canUpload(coupleId, itemId) {
      return isActiveMember(coupleId)
             && mediaExists(coupleId, itemId)
             && media(coupleId, itemId).ownerUid == request.auth.uid
             && media(coupleId, itemId).state == 'PENDING';
    }

    // Sent media is the couple's; one still being uploaded is its author's alone.
    function canRead(coupleId, itemId) {
      return isActiveMember(coupleId)
             && mediaExists(coupleId, itemId)
             && (media(coupleId, itemId).state == 'SENT'
                 || media(coupleId, itemId).ownerUid == request.auth.uid);
    }

    match /couples/{coupleId}/voice/{itemId}/{file} {
      allow read: if canRead(coupleId, itemId);
      allow create: if canUpload(coupleId, itemId) && isAudio();
      allow update, delete: if false;
    }

    match /couples/{coupleId}/media/{itemId}/{file} {
      allow read: if canRead(coupleId, itemId);
      allow create: if canUpload(coupleId, itemId) && isImage();
      allow update, delete: if false;
    }

    // What a couple chose to keep (§14.8). Memories are built in Phase 18; until then the
    // path exists so nothing can be written into it by mistake.
    match /couples/{coupleId}/memories/{memoryId}/{file} {
      allow read, write: if false;
    }

    match /couples/{coupleId}/{allPaths=**} {
      allow read, write: if false;
    }

    // ---- content bundles -------------------------------------------------
    // Authored content is not private; the SELECTION of it is (§9.2).

    match /content/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false; // Published by tools/, never by a client.
    }

    // ---- default deny ----------------------------------------------------

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
