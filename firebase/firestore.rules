rules_version = '2';

// Afterhours Firestore rules.
//
// The governing principle (BUILD_PROMPT.md §7.1): client-side hiding is not security.
// If a rule does not enforce it, it is not enforced. Every privacy claim in §5 must be
// provable by an emulator rules test — see firebase/tests/ (added in Phase 21, extended
// by each phase that introduces a collection).
//
// Rules are added by the phase that introduces the collection. Anything not explicitly
// allowed is denied by the final catch-all.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ---------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Fields the server owns. A client may never write these, on create or update.
    // Takes a key SET, so it works with both request.resource.data.keys() and
    // diff(...).affectedKeys().
    function noServerFields(keys) {
      return !keys.hasAny([
        'entitlement', 'coupleId', 'contentLevelEffective',
        'revealedAt', 'state', 'reveal',
        // The pairing handshake. If this were client-writable, a user could forge an
        // approval or show their partner fake verification symbols.
        'pairing'
      ]);
    }

    // Shape of the client-writable profile fields (§6.1). Every field is optional, but
    // whatever is present must be well-formed — a malformed attestation in particular must
    // never be accepted as a record that someone confirmed their age (§3.1).
    //
    // Shape only. Time is checked separately in attestationStampedNow(), and only on the
    // write that changes the attestation: re-checking a stored timestamp here would make
    // every later profile edit fail once the original write was old enough.
    function validProfile(data) {
      return (!('ageAttestation' in data) || (
                data.ageAttestation is map
                && data.ageAttestation.keys().hasOnly(['confirmed', 'at'])
                && data.ageAttestation.confirmed is bool
                && data.ageAttestation.at is timestamp))
          && (!('displayName' in data) || (
                data.displayName is string && data.displayName.size() <= 60))
          && (!('timezone' in data) || (
                data.timezone is string && data.timezone.size() <= 64))
          && (!('contentLevel' in data) || (
                data.contentLevel is int && data.contentLevel >= 1 && data.contentLevel <= 5))
          && (!('privacySettings' in data) || (
                data.privacySettings is map
                && data.privacySettings.keys().hasOnly(['appLock', 'analyticsOptOut'])))
          && (!('notificationSettings' in data) || validNotificationSettings(data.notificationSettings));
    }

    // What the server checks before it sends anything (§16). The shape matters because the
    // server reads it: a malformed quiet-hours window must not become a silent phone, and
    // `enabled` must be a bool or nothing at all.
    function validNotificationSettings(settings) {
      return settings is map
          && settings.keys().hasOnly(['enabled', 'showContent', 'quietHours'])
          && (!('enabled' in settings) || settings.enabled is bool)
          && (!('showContent' in settings) || settings.showContent is bool)
          && (!('quietHours' in settings) || settings.quietHours == null || (
                settings.quietHours is map
                && settings.quietHours.keys().hasOnly(['from', 'to'])
                && settings.quietHours.from is string && settings.quietHours.from.size() == 5
                && settings.quietHours.to is string && settings.quietHours.to.size() == 5));
    }

    // A phone signed in as this user, so the server knows where to send (§16). Only ever the
    // user's own: a token written into someone else's list would deliver their notifications
    // to the writer's phone.
    function validFcmToken(data) {
      return data.keys().hasAll(['token', 'platform', 'updatedAt'])
          && data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && data.token is string && data.token.size() > 0 && data.token.size() <= 4096
          && data.platform == 'ANDROID'
          && data.updatedAt == request.time;
    }

    // The attestation is an audit record, so its time is the server's, not the device's
    // (§3.1, §7.1). The client writes serverTimestamp(); a client-chosen time — back-dated,
    // future-dated or just skewed — is rejected. Only enforced on the write that sets or
    // changes the attestation.
    function attestationStampedNow(changedKeys) {
      return !changedKeys.hasAny(['ageAttestation'])
          || request.resource.data.ageAttestation.at == request.time;
    }

    // A private answer (§6.1, Phase 5). Exactly these four fields, so nothing can ride along
    // in the most sensitive documents in the database. `secret` only with CURIOUS: that pair
    // is what "secretly curious" means, and no other combination is. The time is the
    // server's. The id rule matches the taxonomy's, so a stray path cannot be written either.
    function validPreference(preferenceId, data) {
      return preferenceId.matches('^[a-z0-9_]{1,64}$')
          && data.keys().hasAll(['value', 'secret', 'updatedAt', 'taxonomyVersion'])
          && data.keys().hasOnly(['value', 'secret', 'updatedAt', 'taxonomyVersion'])
          && data.value in ['YES', 'CURIOUS', 'MAYBE', 'NOT_FOR_ME', 'NEVER']
          && data.secret is bool
          && (!data.secret || data.value == 'CURIOUS')
          && data.updatedAt == request.time
          && data.taxonomyVersion is int
          && data.taxonomyVersion >= 1;
    }

    // A private boundary (§6.1, Phase 6). Level, an optional note to self, and the server's
    // time — nothing else. The note is the user's own and is read by no one else, not even
    // the server's filters. Theme ids follow the taxonomy's id rule.
    function validBoundary(themeId, data) {
      return themeId.matches('^[a-z0-9_]{1,64}$')
          && data.keys().hasAll(['level', 'updatedAt'])
          && data.keys().hasOnly(['level', 'note', 'updatedAt'])
          && data.level in ['ALWAYS_OK', 'CURIOUS', 'ASK_FIRST', 'NOT_TONIGHT', 'NEVER']
          && (!('note' in data) || data.note == null
                || (data.note is string && data.note.size() <= 200))
          && data.updatedAt == request.time;
    }

    // ---- users -----------------------------------------------------------
    // A user document is readable and writable only by its owner. `coupleId` and
    // `entitlement` are written exclusively by Cloud Functions (§7.2).

    match /users/{uid} {
      allow get, list: if isSelf(uid);
      allow create: if isSelf(uid)
                    && noServerFields(request.resource.data.keys())
                    && validProfile(request.resource.data)
                    && attestationStampedNow(request.resource.data.keys());
      allow update: if isSelf(uid)
                    && noServerFields(request.resource.data.diff(resource.data).affectedKeys())
                    && validProfile(request.resource.data)
                    && attestationStampedNow(request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false; // Account deletion goes through a Cloud Function (§72).

      // ---- private, owner-only for life (§5.1) ---------------------------
      // There is deliberately NO rule anywhere that grants a partner read access to
      // these paths. Not on reveal, not on match, not ever. Mutual matches are computed
      // server-side and only positives are materialised (§5.2).

      match /preferences/{preferenceId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validPreference(preferenceId, request.resource.data);
        // Forgetting an answer deletes it: an unanswered item has no document.
        allow delete: if isSelf(uid);
      }

      match /boundaries/{themeId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validBoundary(themeId, request.resource.data);
        // Clearing a boundary deletes it: an unset theme has no document.
        allow delete: if isSelf(uid);
      }

      match /affinity/{dimensionId} {
        allow read: if isSelf(uid);
        allow write: if false; // Derived from feedback by a Cloud Function.
      }

      // Where this user's phones can be reached (§16). The server reads them; nobody else can.
      match /fcmTokens/{tokenId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid) && validFcmToken(request.resource.data);
      }
    }

    // ---- server-only collections ----------------------------------------
    // No client access at all. Admin SDK only.

    match /pairingCodes/{code} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false; // Written via callable; reporter identity never exposed.
    }

    // ---- couples ---------------------------------------------------------
    // Readable only by its two ACTIVE members. After unpairing, neither partner can read
    // it any more (every couple-scoped path hangs off this check).
    //
    // No client writes at all yet: couples are created, joined and ended only by Cloud
    // Functions, inside transactions (BUILD_PROMPT.md section 8). That is what makes
    // "exactly two members" and "one couple per person" hold (section 7.3, test M).

    // One reaction to one played chapter (§6.1 feedback). Exactly these fields; the time is
    // the server's; the content must be what that chapter was when it was played.
    function validFeedback(coupleId, feedbackId, data) {
      let night = get(/databases/$(database)/documents/couples/$(coupleId)/experiences/$(data.experienceId)).data;
      return data.keys().hasAll(['experienceId', 'chapterIndex', 'contentId', 'reaction', 'byUid', 'at'])
          && data.keys().hasOnly(['experienceId', 'chapterIndex', 'contentId', 'reaction', 'byUid', 'at'])
          && data.byUid == request.auth.uid
          && data.experienceId is string && data.experienceId.matches('^[A-Za-z0-9]{1,64}$')
          && data.chapterIndex is int && data.chapterIndex >= 0
          && feedbackId == data.experienceId + '_' + string(data.chapterIndex) + '_' + request.auth.uid
          && data.reaction in ['LOVED', 'FINE', 'NOT_FOR_US']
          && data.at == request.time
          && night.status in ['COMPLETED', 'ABANDONED']
          && data.chapterIndex < night.playedThrough
          && night.chapters[data.chapterIndex].contentIds[0] == data.contentId;
    }

    function isActiveMember(coupleId) {
      let couple = get(/databases/$(database)/documents/couples/$(coupleId));
      return isSignedIn()
          && couple.data.status == 'ACTIVE'
          && request.auth.uid in couple.data.memberUids;
    }

    match /couples/{coupleId} {
      allow get: if isActiveMember(coupleId);
      allow list, write: if false;

      match /members/{memberUid} {
        allow read: if isActiveMember(coupleId);
        allow write: if false;
      }

      // What each partner has bought (D-149): a pack opens its levels for both of them, so each
      // phone says how far its own packs reach and reads the other's. One document per member, its
      // id their own uid. The only thing in it is a level a pack can be — Spicy, Hot or Extreme —
      // and when it was said, by the server's clock.
      //
      // It decides nothing that costs the project anything. A pack opens content that already
      // shipped inside the APK (V2 rule 5), so a partner who wrote a level they had not bought would
      // get cards they already had on disk; every gate that does cost something is still the
      // server's own. That is why a client may write this at all, and why only its own.
      match /packs/{packUid} {
        allow get, list: if isActiveMember(coupleId);
        allow create, update: if isSelf(packUid)
                              && isActiveMember(coupleId)
                              && request.resource.data.keys().hasOnly(['level', 'at'])
                              && request.resource.data.keys().hasAll(['level', 'at'])
                              && request.resource.data.level is int
                              && request.resource.data.level >= 3
                              && request.resource.data.level <= 5
                              && request.resource.data.at == request.time;
        allow delete: if false;
      }

      // Released mutual matches (§5.2): positives only, and only what the server revealed.
      // A member may do exactly one thing to one — mark it seen, for themselves. No client
      // can create, delete or reword a match (§7.3 row R), and no answer is ever in here.
      match /mutualPreferences/{prefId} {
        allow get, list: if isActiveMember(coupleId);
        allow update: if isActiveMember(coupleId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
                      && request.resource.data.seenBy.diff(resource.data.seenBy).affectedKeys()
                           .hasOnly([request.auth.uid])
                      && request.resource.data.seenBy[request.auth.uid] == true;
        allow create, delete: if false;
      }

      // An answer for the chapter a session is on (§12.2): exactly these fields, the caller's
      // own uid, the chapter the id names, and a live session of this couple currently on that
      // chapter. The answer itself is one short string, or nothing at all — a partner who is
      // simply done with a chapter submits null.
      function validSubmission(coupleId, sessionId, submissionId, data) {
        return data.keys().hasOnly(['chapter', 'byUid', 'answer', 'at'])
            && data.byUid == request.auth.uid
            && data.chapter is int
            && submissionId == string(data.chapter) + '_' + request.auth.uid
            && (data.answer == null || (data.answer is string && data.answer.size() <= 700))
            && data.at == request.time
            && liveChapter(coupleId, sessionId, data.chapter);
      }

      // A countdown is a title, a moment to wait for, and who made it. Nothing else.
      function validCountdown(data) {
        return data.keys().hasOnly(['title', 'targetAt', 'createdBy', 'createdAt'])
            && data.keys().hasAll(['title', 'targetAt', 'createdBy', 'createdAt'])
            && data.title is string && data.title.size() > 0 && data.title.size() <= 60
            && data.targetAt is timestamp
            && data.createdBy == request.auth.uid
            && data.createdAt == request.time;
      }

      // A message: whose, when, what kind, and at most one piece of media by id.
      //
      // `at == request.time` is the load-bearing one. Without it a phone could back-date a message
      // into the middle of a conversation, or post-date one to the top of it for ever.
      function validMessage(data) {
        let keys = data.keys();
        let hasText = keys.hasAny(['text']);
        let hasMedia = keys.hasAny(['mediaId']);
        return keys.hasOnly(['from', 'at', 'kind', 'text', 'mediaId'])
            && keys.hasAll(['from', 'at', 'kind'])
            && data.from == request.auth.uid
            && data.at == request.time
            && data.kind in ['TEXT', 'VOICE', 'PHOTO']
            && (!hasText || (data.text is string && data.text.size() <= 2000))
            && (!hasMedia || data.mediaId is string)
            // A text message is words and nothing else; media carries its own record.
            && (data.kind != 'TEXT' || (hasText && data.text.size() > 0 && !hasMedia))
            && (data.kind == 'TEXT' || hasMedia);
      }

      // The session is under way, on this chapter, and this phone is playing it.
      function liveChapter(coupleId, sessionId, chapter) {
        let session = get(/databases/$(database)/documents/couples/$(coupleId)/sessions/$(sessionId)).data;
        return session.currentChapter == chapter
            && session.kind == 'TWO_DEVICE'
            && session.state in ['CHAPTER_ACTIVE', 'AWAITING_SUBMISSIONS'];
      }

      // Nights the engine built for the couple (§6.1, §10). Written only by the server
      // (generateExperience); both members read them. They hold content ids, never anything
      // about either partner's answers or limits.
      match /experiences/{experienceId} {
        // A night one partner planned for the other (§2.5 #2) is readable only by the partner
        // it was planned for: the surprise is the point, and the planner already knows the
        // shape they asked for. Listing is closed for the same reason — a list would hand the
        // planner every document it must not read.
        allow get: if isActiveMember(coupleId)
                   && (!('plannedFor' in resource.data) || resource.data.plannedFor == null
                       || isSelf(resource.data.plannedFor));
        allow list: if false;
        allow write: if false;

        // Each partner's ask-first items (§3.2), readable by that partner alone: the other
        // must not learn that a limit exists, or where.
        match /askFirst/{askUid} {
          allow get: if isSelf(askUid) && isActiveMember(coupleId);
          allow list, write: if false;
        }
      }

      // Something one partner left for the other to find later (§5.7, §13): a scheduled
      // surprise, an "Open when…", a capsule. Both may see that it exists — that is the hook —
      // and the server writes every one of them.
      match /surprises/{surpriseId} {
        allow get, list: if isActiveMember(coupleId);
        allow write: if false;

        // What is in it. Readable by its author at any time, and by anyone in the couple only
        // once the server has delivered it (§7.3 row S). "Hidden in the UI" is not a rule.
        match /payload/{payloadId} {
          allow get: if isActiveMember(coupleId)
                     && (isSelf(resource.data.ownerUid) || resource.data.deliveredAt != null);
          allow list, write: if false;
        }
      }

      // A few days of this (§13): the plan, its days and where each one stands. The server
      // writes every part of it — which day is open is a fact about the clock and about what
      // they have played, not something a phone decides.
      match /arcs/{arcId} {
        allow get, list: if isActiveMember(coupleId);
        allow write: if false;
      }

      // The couple's own library (§14.8). The server writes one from a night they played — it
      // never holds a content id, so a memory cannot become a way to read a night one partner
      // planned for the other (D-081, D-090). Both read them; both may mark one a favourite, and
      // that is the only field a phone may change.
      match /memories/{memoryId} {
        allow get, list: if isActiveMember(coupleId);
        allow update: if isActiveMember(coupleId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favorite'])
                      && request.resource.data.favorite is bool;
        allow create, delete: if false;
      }

      // A countdown to something they are both waiting for (§13). Either partner may make one
      // and either may remove it; there is nothing private in it.
      match /countdowns/{countdownId} {
        allow get, list: if isActiveMember(coupleId);
        allow create: if isActiveMember(coupleId) && validCountdown(request.resource.data);
        allow update: if isActiveMember(coupleId)
                      && validCountdown(request.resource.data)
                      && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isActiveMember(coupleId);
      }

      // A voice note or a photo one partner sent the other (§13, §5.8). The server writes
      // every one of these: what it is, where it is, when it expires and whether it burns.
      // A client never writes one, and a deleted one takes its object with it (§7.3 row P).
      match /media/{itemId} {
        allow get, list: if isActiveMember(coupleId);
        allow write: if false;
      }

      // What the two of them say to each other (CHAT_PROMPT.md).
      //
      // The one collection under a couple that a client writes outright, and the reason is that
      // there is nothing to compute: a message is their own words to the only other person who
      // can read them. What the rules hold is the shape — whose it is, when it was, and that it
      // is never edited afterwards.
      match /messages/{messageId} {
        allow get, list: if isActiveMember(coupleId);
        allow create: if isActiveMember(coupleId) && validMessage(request.resource.data);
        // Said is said: a message is not rewritten after the other phone has read it.
        allow update: if false;
        // Your own, and it goes for both of you — there is no "delete for me" in a room of two.
        allow delete: if isActiveMember(coupleId) && resource.data.from == request.auth.uid;
      }

      // How far each of them has read (CHAT_PROMPT.md §3.2). Owner-only, because a phone saying
      // the *other* one had read something would be a lie with nobody to catch it.
      match /chatState/{uid} {
        allow get, list: if isActiveMember(coupleId);
        allow write: if isActiveMember(coupleId) && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(['lastReadAt'])
                     && request.resource.data.lastReadAt == request.time;
      }

      // What one partner has planned for the other (§2.5 #2, §13): that there is something,
      // and how big it is. Never what is in it — that lives in the experience, which only the
      // partner it was planned for may read.
      match /plans/{planId} {
        allow get, list: if isActiveMember(coupleId);
        allow write: if false;
      }

      // A night being played (§3.1, §12). Server-authoritative: every transition, every
      // "I'm in", pause and stop goes through a callable that checks it against the legal
      // transitions, inside a transaction. Both members read it — it is how the other phone
      // knows the night is paused, waiting for consent, or over. Nothing in it says who
      // stopped a night (DECISIONS.md D-059).
      match /sessions/{sessionId} {
        allow get: if isActiveMember(coupleId);
        allow list, write: if false;

        // What one partner answered for the chapter they are on, from their own phone (§12.2).
        // Write-only, and only your own: no client ever reads a submission — not the other
        // partner's, not even their own, and not after the reveal (§7.3 rows D, E, F). What both
        // may see is the reveal below, which the server writes from the pair.
        //
        // The id says which chapter and whose answer it is, so the rules can check both without
        // reading anything: `{chapter}_{uid}`.
        match /submissions/{submissionId} {
          allow read: if false;
          allow create: if isActiveMember(coupleId)
                        && submissionId.matches('^[0-9]+_' + request.auth.uid + '$')
                        && validSubmission(coupleId, sessionId, submissionId, request.resource.data);
          allow update, delete: if false;
        }

        // The reveal for a chapter: both partners' answers, side by side, written by the server
        // only once both have answered (onSubmissionCreated). A client cannot write one, so it
        // cannot reveal early, or at all (§7.3 row G).
        match /rounds/{chapterIndex} {
          allow get, list: if isActiveMember(coupleId);
          allow write: if false;
        }

        // "I'm still here" (§12.3), every twenty seconds while a session is on screen. Each
        // phone writes its own and reads the other's: it is how a partner dropping out shows,
        // and how a session nobody is in expires. It carries nothing but the time.
        match /presence/{presenceUid} {
          allow get, list: if isActiveMember(coupleId);
          allow create, update: if isSelf(presenceUid)
                                && isActiveMember(coupleId)
                                && request.resource.data.keys().hasOnly(['at'])
                                && request.resource.data.at == request.time;
          allow delete: if false;
        }
      }

      // What a partner thought of a chapter (§6.1), which the server turns into their own
      // affinity (onFeedbackCreated). Private to whoever gave it: the other partner cannot read
      // it (DECISIONS.md D-063). One per partner per chapter — the id says which — only for a
      // chapter of this couple's night that was actually played, and never edited after.
      match /feedback/{feedbackId} {
        // Only ever an id ending in the caller's own uid — so a partner cannot even learn
        // whether the other reacted — and then whether it exists yet: the app checks before
        // writing, because feedback cannot be written twice.
        allow get: if isActiveMember(coupleId)
                   && feedbackId.matches('^[A-Za-z0-9]{1,64}_[0-9]+_' + request.auth.uid + '$')
                   && (resource == null || resource.data.byUid == request.auth.uid);
        allow create: if isActiveMember(coupleId) && validFeedback(coupleId, feedbackId, request.resource.data);
        allow list, update, delete: if false;
      }
    }

    // What the engine remembers between nights (play history for cooldowns). Server-only:
    // it is the engine's input, and nothing a client needs to read or may shape.
    match /couples/{coupleId}/engineState/{document=**} {
      allow read, write: if false;
    }

    // Matches waiting for their random release time (§5.3). If a client could see this, it
    // could date a partner's answers — the exact inference the queue exists to prevent.
    match /couples/{coupleId}/revealQueue/{document=**} {
      allow read, write: if false;
    }

    // The combined boundary intersection must never reach a device: a user could diff
    // it against their own boundaries to derive their partner's hard limits (§5.4).
    match /couples/{coupleId}/engineFilters/{document=**} {
      allow read, write: if false;
    }

    // ---- content ---------------------------------------------------------
    // Authored content is not private; the SELECTION of it is (§9.2). Deltas are admin
    // overrides on the shipped bundle — disable flags and edited items — written only by
    // tools/content-delta. Any signed-in app may read them, and no client may write.
    match /content/{itemId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // The content pointer, written by tools/publish-content. The server's engine reads it in
    // every environment; the dev app reads it in place of Remote Config, which has no
    // emulator (DECISIONS.md D-041).
    match /contentMeta/pointer {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // ---- default deny ----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
