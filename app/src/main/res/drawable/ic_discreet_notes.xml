        android:fillColor="#F2E6DA"
        android:pathData="M34,26h34l10,10v46a4,4 0 0 1 -4,4H38a4,4 0 0 1 -4,-4V30a4,4 0 0 1 4,-4z" />
    <path
        android:fillColor="#CBBAAE"
        android:pathData="M68,26l10,10h-10z" />
    <path
        android:strokeColor="#8A6D32"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M44,48h20 M44,58h20 M44,68h12" />
