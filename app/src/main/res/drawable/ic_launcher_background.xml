<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher's ground (DESIGN_PROMPT.md §7).

  A burgundy-to-ink radial, off-centre, so the icon is lit from the same corner every screen in
  the app is. The values are the design system's own Palette.BurgundyDeep and Palette.Scene; they
  are repeated here because a drawable cannot read a Compose token, and Scene is the same colour
  the window is painted so there is no seam at launch.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38"
                android:centerY="32"
                android:gradientRadius="86">
                <item android:color="#FF8E2A47" android:offset="0.0" />
                <item android:color="#FF3D1424" android:offset="0.55" />
                <item android:color="#FF0B0708" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
