<?xml version="1.0" encoding="utf-8"?>
<!--
  The monogram (DESIGN_PROMPT.md §7).

  An "A" with a high-contrast stem, drawn rather than set: a launcher icon is rasterised at sizes
  where a hinted font stops behaving, and the app's display face is not available to a drawable.
  The proportions are Playfair's — thin bracket, heavy diagonal, a crossbar low on the counter.

  Inside the 66 dp safe zone of a 108 dp adaptive icon, so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The heavy right diagonal. -->
    <path
        android:fillColor="#FFF2E6DA"
        android:pathData="M56.5,30 L72.5,78 L63.5,78 L49.5,34.5 Z" />
    <!-- The thin left diagonal. -->
    <path
        android:fillColor="#FFF2E6DA"
        android:pathData="M51.5,30 L55.5,30 L40.5,78 L35.5,78 Z" />
    <!-- The crossbar, low, as a transitional serif sets it. -->
    <path
        android:fillColor="#FFF2E6DA"
        android:pathData="M43.5,62 L64.5,62 L63,66.5 L42,66.5 Z" />
</vector>
