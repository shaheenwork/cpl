<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".CplApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cpl">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cpl"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <!--
              Invite links: afterhours://pair?code=123456 (BUILD_PROMPT.md section 8).
              A custom scheme until an App Links domain exists; see DECISIONS.md D-016.
              singleTask so a link opened from a chat app lands in the existing instance
              rather than stacking a second copy of the app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="afterhours" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
          Discreet launcher icons (M8).

          Three aliases over one activity. Exactly one is enabled at a time: the default is
          enabled in the manifest and the other two are not, and switching swaps which component
          the launcher sees. The activity itself is never disabled, so a deep link and a
          notification keep working whichever icon is showing.

          Nothing here imitates another product. The names are generic words and the icons are
          drawn, because an app that passes for somebody else's is what Play's deceptive-behaviour
          policy is about — the point is an icon that does not announce what this app is, not one
          that claims to be a different app.
        -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNotes"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_discreet_notes"
            android:roundIcon="@mipmap/ic_discreet_notes"
            android:label="@string/app_name_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCalculator"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_discreet_calculator"
            android:roundIcon="@mipmap/ic_discreet_calculator"
            android:label="@string/app_name_calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          WorkManager is configured by CplApplication (Hilt builds the workers), so its
          default initializer must not run first.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>