<?xml version="1.0" encoding="utf-8"?>
<!--
  First-launch defaults. The app must behave correctly before any Remote Config fetch
  completes, so every key in RemoteConfigKeys has a value here.
-->
<defaultsMap>
    <entry>
        <key>minimum_app_version</key>
        <value>1</value>
    </entry>
    <entry>
        <key>maintenance_mode</key>
        <value>false</value>
    </entry>
    <!-- The version of the bundle shipped in the app (content/content.json). Anything lower
         than what is installed is ignored, so this default never downgrades content. -->
    <entry>
        <key>content_version</key>
        <value>1</value>
    </entry>

    <entry>
        <key>feature_apart_mode</key>
        <value>true</value>
    </entry>
    <entry>
        <key>feature_multi_day_arcs</key>
        <value>true</value>
    </entry>
    <entry>
        <key>feature_voice</key>
        <value>true</value>
    </entry>
    <entry>
        <key>feature_photo_challenges</key>
        <value>true</value>
    </entry>
    <entry>
        <key>feature_subscription</key>
        <value>false</value>
    </entry>

    <entry>
        <key>weight_mutual_preference</key>
        <value>3.0</value>
    </entry>
    <entry>
        <key>weight_affinity</key>
        <value>2.0</value>
    </entry>
    <entry>
        <key>weight_mood_match</key>
        <value>2.0</value>
    </entry>
    <entry>
        <key>weight_novelty</key>
        <value>1.5</value>
    </entry>
    <entry>
        <key>weight_intensity_fit</key>
        <value>1.5</value>
    </entry>
    <entry>
        <key>weight_recency_penalty</key>
        <value>2.0</value>
    </entry>
    <entry>
        <key>weight_repetition_penalty</key>
        <value>3.0</value>
    </entry>
    <!--
      The free period (D-151). The date the app ships with, so a first launch before any fetch lands
      — and a value somebody mistypes in the console — behaves as announced rather than guessing.
      Must stay the same string as FreeUntil.DEFAULT in :core:data, which cannot be read from here.
    -->
    <entry>
        <key>free_until</key>
        <value>2026-11-06</value>
    </entry>
</defaultsMap>
