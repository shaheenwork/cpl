<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 13+ asks before a single notification may be posted (§16). Declared here, with
      the module that posts them, and requested from the home screen the first time.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
