<?xml version="1.0" encoding="utf-8"?>
<!--
  The camera needs somewhere to write (CHAT_PRODUCTION_PROMPT.md section 1.2).

  ACTION_IMAGE_CAPTURE hands the photo back by writing into a URI the caller provides, so without
  a provider there is nothing to give it and the camera cannot be opened at all. The file is one
  this app made in its own cache, and the grant is per-call.

  The CAMERA permission is deliberately absent: with it declared, the platform requires it at
  runtime for ACTION_IMAGE_CAPTURE; without it, the camera app takes the picture on this app's
  behalf and no permission is needed. Declaring one this app does not use would only mean asking.

  The authority carries ${applicationId} because the flavours install side by side — a fixed
  authority makes the second install fail outright.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
